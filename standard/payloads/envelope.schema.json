{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://osf-schemas/next/payloads/envelope.schema.json",
  "title": "OSF payload envelope (NATS, MQTT, Kafka) - v1.1.0",
  "description": "GENERATED from standard/sync/uns-convention.json 2.0.0 by i3x-v5 packages/schemas-ci/gen-payloads.mjs; do not edit by hand. Two shapes. signal = OT world (categories machine): one message per signal; telemetry on factory.{site}.{machine}.telemetry.{attr}, transactional on factory.{site}.{machine}.event.{attr} (streams FACTORY_TELEMETRY / FACTORY_TRANSACTIONAL). entity = IT world (categories business, material, quality, equipment): one message per source row on business.{enterprise}.{sourceId}.{entity}.{eventType}.{id} (stream BUSINESS), always transactional. A transactional message carries msgId: the JetStream Nats-Msg-Id and the Kafka key, for deduplication. b2m (optional): the ISA-95 Part 5 transaction verb and action code — a row is SYNC Add / Change / Delete (its eventType), a transactional signal SYNC Add, telemetry none.",
  "definitions": {
    "b2m": {
      "type": "object",
      "description": "ISA-95 Part 5 transaction (B2MML 0701): the verb, and the action code of a SYNC (Add, Change, Delete) or of an answer (ACKNOWLEDGE, CONFIRM: Accepted, Modified, Rejected; RESPOND: also Replaced).",
      "required": [
        "verb"
      ],
      "additionalProperties": false,
      "properties": {
        "verb": {
          "enum": [
            "GET",
            "SHOW",
            "PROCESS",
            "ACKNOWLEDGE",
            "CHANGE",
            "RESPOND",
            "CANCEL",
            "CONFIRM",
            "SYNC"
          ]
        },
        "actionCode": {
          "enum": [
            "Add",
            "Change",
            "Delete",
            "Replaced",
            "Accepted",
            "Modified",
            "Rejected"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verb": {
                "enum": [
                  "SYNC"
                ]
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "required": [
              "actionCode"
            ],
            "properties": {
              "actionCode": {
                "enum": [
                  "Add",
                  "Change",
                  "Delete"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "enum": [
                  "ACKNOWLEDGE",
                  "CONFIRM"
                ]
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {
              "actionCode": {
                "enum": [
                  "Accepted",
                  "Modified",
                  "Rejected"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "enum": [
                  "RESPOND"
                ]
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {
              "actionCode": {
                "enum": [
                  "Accepted",
                  "Modified",
                  "Rejected",
                  "Replaced"
                ]
              }
            }
          }
        }
      ]
    },
    "signal": {
      "type": "object",
      "required": [
        "element_id",
        "attr",
        "value",
        "timestamp",
        "delivery"
      ],
      "properties": {
        "element_id": {
          "type": "string",
          "pattern": "^[^+#*>/\\s]+$",
          "description": "Machine key (contract nodes.Machine.key); a subject token."
        },
        "attr": {
          "type": "string",
          "description": "Attribute name of the machine profile."
        },
        "value": {
          "description": "The value, typed by the attribute (x-signals of the profile payload)."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Source timestamp, UTC."
        },
        "delivery": {
          "enum": [
            "telemetry",
            "transactional"
          ],
          "description": "The delivery class of the attribute (profile `delivery`); it decides the subject."
        },
        "msgId": {
          "type": "string",
          "minLength": 1,
          "description": "Unique message id (Nats-Msg-Id / Kafka key). Required for transactional."
        },
        "quality": {
          "type": "string",
          "description": "OPC UA StatusCode of the reading (Good, Uncertain, Bad...)."
        },
        "unit": {
          "type": "string",
          "description": "UNECE Rec. 20 code of the attribute."
        },
        "profileRef": {
          "type": "string",
          "pattern": "^SMProfile-"
        },
        "profileVersion": {
          "type": "string"
        },
        "b2m": {
          "$ref": "#/definitions/b2m"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "delivery": {
                "const": "transactional"
              }
            },
            "required": [
              "delivery"
            ]
          },
          "then": {
            "required": [
              "msgId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "delivery": {
                "const": "transactional"
              }
            },
            "required": [
              "delivery"
            ]
          },
          "then": {
            "properties": {
              "b2m": {
                "properties": {
                  "verb": {
                    "const": "SYNC"
                  },
                  "actionCode": {
                    "const": "Add"
                  }
                }
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "b2m"
              ]
            }
          }
        }
      ]
    },
    "entity": {
      "type": "object",
      "required": [
        "eventType",
        "id",
        "entity",
        "timestamp",
        "msgId",
        "data"
      ],
      "properties": {
        "eventType": {
          "enum": [
            "created",
            "updated",
            "deleted"
          ],
          "description": "Runtime token of the subject."
        },
        "id": {
          "type": "string",
          "pattern": "^[^+#*>/\\s]+$",
          "description": "The row key = the kgIdProperty value of the profile; a subject token."
        },
        "entity": {
          "type": "string",
          "description": "kgNodeLabel of the profile."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "delivery": {
          "const": "transactional"
        },
        "msgId": {
          "type": "string",
          "minLength": 1,
          "description": "Unique message id (Nats-Msg-Id / Kafka key)."
        },
        "profileRef": {
          "type": "string",
          "pattern": "^SMProfile-"
        },
        "profileVersion": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "description": "The attributes of the profile, typed per profile."
        },
        "b2m": {
          "$ref": "#/definitions/b2m"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "created"
              }
            },
            "required": [
              "eventType"
            ]
          },
          "then": {
            "properties": {
              "b2m": {
                "properties": {
                  "verb": {
                    "const": "SYNC"
                  },
                  "actionCode": {
                    "const": "Add"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "updated"
              }
            },
            "required": [
              "eventType"
            ]
          },
          "then": {
            "properties": {
              "b2m": {
                "properties": {
                  "verb": {
                    "const": "SYNC"
                  },
                  "actionCode": {
                    "const": "Change"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "deleted"
              }
            },
            "required": [
              "eventType"
            ]
          },
          "then": {
            "properties": {
              "b2m": {
                "properties": {
                  "verb": {
                    "const": "SYNC"
                  },
                  "actionCode": {
                    "const": "Delete"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
