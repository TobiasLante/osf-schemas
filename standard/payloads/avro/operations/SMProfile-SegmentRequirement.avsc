{
  "type": "record",
  "name": "SegmentRequirement",
  "namespace": "org.openshopfloor.payload.operations",
  "doc": "GENERATED from standard/profiles/operations/segment-requirement.json 2.0.0; do not edit by hand. Kafka value schema (TopicNameStrategy).",
  "fields": [
    {
      "name": "eventType",
      "type": {
        "type": "enum",
        "name": "EventType",
        "symbols": [
          "created",
          "updated",
          "deleted"
        ]
      }
    },
    {
      "name": "id",
      "type": "string"
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "profileVersion",
      "type": "string",
      "default": "2.0.0"
    },
    {
      "name": "segment_requirement_no",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Identity of the SegmentRequirement (join key). Recommendation: <production_order_no>.<sequence>."
    },
    {
      "name": "production_order_ref",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "FK to ProductionOrder.production_order_no (PART_OF). The OperationsRequest to which this segment target belongs."
    },
    {
      "name": "process_segment_ref",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "FK to ProcessSegment.process_segment_no (FOR_PROCESS_SEGMENT). Which manufacturing stage (= plant = Function) is planned here."
    },
    {
      "name": "sequence",
      "type": [
        "null",
        "int"
      ],
      "default": null,
      "doc": "Sequence of this segment within the order."
    },
    {
      "name": "material_ref",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "FK to Article.article_no (REQUIRES_MATERIAL) = MaterialRequirement.MaterialDefinitionID. The target material of this stage."
    },
    {
      "name": "material_use",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "ISA-95 MaterialRequirement.MaterialUse — the ROLE of the material in this stage. Encodes the 'Being Consumed/Produced/Tested/Moved'."
    },
    {
      "name": "qty_planned",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Planned quantity of this material role (target). Counterpart to SegmentResponse.qty_actual."
    },
    {
      "name": "unit_of_measure",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Unit of measure of qty_planned (UN/CEFACT code recommended)."
    },
    {
      "name": "equipment_ref",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "FK to Machine.machine_id (REQUIRES_EQUIPMENT; Machine ≡ Unit level) = EquipmentRequirement.EquipmentID. The target equipment of the stage."
    },
    {
      "name": "planned_start_time",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null,
      "doc": "Planned stage start (target)."
    },
    {
      "name": "planned_end_time",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null,
      "doc": "Planned stage end (target)."
    }
  ]
}
