          },
          {
            "name": "planned_end_time",
            "type": [
              "null",
              {
                "type": "long",
                "logicalType": "timestamp-millis"
              }
            ],
            "default": null,
            "doc": "Planned completion date (target). Counterpart to actual_end_time. Driver of the late_delivery rule."
