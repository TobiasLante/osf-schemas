      "type": [
        "null",
        "int"
      ],
      "default": null,
      "doc": "ISO-8601 weekday, 1=Monday .. Full text: docs/history/standard/profiles/operations/shift-window.md, attributes › day_of_week › description."
    },
    {
      "name": "shift_id",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Shift code as the ERP names it. Full text: docs/history/standard/profiles/operations/shift-window.md, attributes › shift_id › description."
    },
    {
      "name": "start_time",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Window start on the PLANT CLOCK as HH:MM:SS. No date and no timezone — this is a weekly pattern, not an instant. A consumer applies it in the same clock it attributes buckets in (golden-shift: tzOffsetMinutes, default 0 = UTC)."
    },
    {
      "name": "end_time",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Window end on the plant clock as HH:MM:SS. Full text: docs/history/standard/profiles/operations/shift-window.md, attributes › end_time › description."
    },
    {
      "name": "break_minutes",
      "type": [
        "null",
        "int"
      ],
      "default": null,
