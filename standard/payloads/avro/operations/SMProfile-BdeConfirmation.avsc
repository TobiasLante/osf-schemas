{
  "type": "record",
  "name": "BdeConfirmation",
  "namespace": "org.openshopfloor.payload.operations",
  "doc": "GENERATED from standard/profiles/operations/bde-confirmation.json 1.1.0; do not edit by hand. Kafka value schema (TopicNameStrategy).",
  "fields": [
    {
      "name": "eventType",
      "type": {
        "type": "enum",
        "name": "EventType",
        "symbols": [
          "created",
          "updated",
          "deleted"
        ]
      }
    },
    {
      "name": "id",
      "type": "string"
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "profileVersion",
      "type": "string",
      "default": "1.1.0"
    },
    {
      "name": "confirmation_no",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "The booking's own identity (e.g. BDE-2026-08-03-2208427). UNIQUE per confirmation — this is what makes the grain safe to key, where production_order_no repeats."
    },
    {
      "name": "production_order_no",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "The production order this booking confirms (RESPONDS_TO). NOT the identity at this grain — many confirmations share one order."
    },
    {
      "name": "article_ref",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Manufactured article (join key to Article)."
    },
    {
      "name": "machine_ref",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Executing machine (machine_no). MEASURED 2026-08-03: non-null on 2000 of 2000 rows at this grain across 81 distinct values, where the per-production-order aggregate carries it on only 32 of 100. The machine binding survives here and is lost there."
    },
    {
      "name": "operation_no",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "The routing operation (Arbeitsgang) this booking belongs to. MEASURED: 1714 of 2000 rows, 30 distinct. Absent on the rest — a booking without an operation is not an error here, and it must stay absent rather than default to a first operation."
    },
    {
      "name": "shift",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Shift of record for the booking, derived upstream from machine_departments x machine_pools x shift_config x shift_weekly_pattern (sim-v5, 2026-08-03). Full text: docs/history/standard/profiles/operations/bde-confirmation.md, attributes › shift › description."
    },
    {
      "name": "good_qty",
      "type": [
        "null",
        "int"
      ],
      "default": null,
      "doc": "Pieces booked as good on this confirmation."
    },
    {
      "name": "scrap_qty",
      "type": [
        "null",
        "int"
      ],
      "default": null,
      "doc": "Pieces booked as scrap on this confirmation. The ERP half of the quantity axis — the counterpart the machine's own part_scrap counter is reconciled against."
    },
    {
      "name": "rework_qty",
      "type": [
        "null",
        "int"
      ],
      "default": null,
      "doc": "Pieces booked for rework — a THIRD disposition, deliberately not folded into scrap (same rule as the part_scrap semantic in standard/mappings/attribute-aliases.json). Full text: docs/history/standard/profiles/operations/bde-confirmation.md, attributes › rework_qty › description."
    },
    {
      "name": "scrap_reason",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Reason code for the scrap on this booking. MEASURED: only 123 of 2000 rows carry one, with 2 distinct values (cavity-defect, quality-fail). Thin by nature — most bookings have no scrap at all — so a consumer must treat absence as 'no reason recorded', never as a category."
    },
    {
      "name": "labor_min",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Personnel minutes booked against this confirmation. Full text: docs/history/standard/profiles/operations/bde-confirmation.md, attributes › labor_min › description."
    },
    {
      "name": "machine_min",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Machine minutes booked against this confirmation."
    },
    {
      "name": "setup_min",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Setup minutes booked against this confirmation. MEASURED: non-zero on 25 of 800 rows — setup is an event, not a per-booking constant, so a zero here is a real 'no setup on this booking'."
    },
    {
      "name": "cycle_time_actual_sec",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Actually measured cycle time per piece (s) for this booking."
    },
    {
      "name": "actual_start_time",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null,
      "doc": "Start of the booked interval (ts_start). Absent at the per-production-order grain."
    },
    {
      "name": "actual_end_time",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null,
      "doc": "End of the booked interval (ts_end)."
    },
    {
      "name": "updated_at",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null,
      "doc": "Last change (recorded_at). Server-managed and volatile on every read."
    }
  ]
}
