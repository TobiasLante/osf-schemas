{
  "type": "record",
  "name": "ProductDefinition",
  "namespace": "org.openshopfloor.payload.operations",
  "doc": "GENERATED from standard/profiles/operations/product-definition.json 2.0.0; do not edit by hand. Kafka value schema (TopicNameStrategy).",
  "fields": [
    {
      "name": "eventType",
      "type": {
        "type": "enum",
        "name": "EventType",
        "symbols": [
          "created",
          "updated",
          "deleted"
        ]
      }
    },
    {
      "name": "id",
      "type": "string"
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "profileVersion",
      "type": "string",
      "default": "2.0.0"
    },
    {
      "name": "product_definition_no",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Spec identity / key."
    },
    {
      "name": "name",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Display name of the product specification."
    },
    {
      "name": "version_label",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Functional spec/recipe version (independent of the profile SemVer)."
    },
    {
      "name": "status",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Lifecycle status, e.g. draft, released, obsolete."
    },
    {
      "name": "article_ref",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "FK to Article.article_no, reached via OperationsSegment SPECIFIES_MATERIAL. The article this spec defines — the FO/recipe join point. First binding axis."
    },
    {
      "name": "equipment_class_ref",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Optional FK to an EquipmentClass/line the spec is restricted to, reached via OperationsSegment SPECIFIES_EQUIPMENT. Second binding axis."
    },
    {
      "name": "setup_ref",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Optional setup/mould binding axis (third axis)."
    },
    {
      "name": "param_name",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Name of the controlled product property (e.g. line_speed, produced_thickness, area_weight)."
    },
    {
      "name": "target_value",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Target / SOLL setpoint of the property."
    },
    {
      "name": "warn_lo",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Inner band lower limit — Warngrenze (warning tier)."
    },
    {
      "name": "warn_hi",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Inner band upper limit — Warngrenze (warning tier)."
    },
    {
      "name": "action_lo",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Outer band lower limit — Eingriffsgrenze (action tier)."
    },
    {
      "name": "action_hi",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Outer band upper limit — Eingriffsgrenze (action tier)."
    },
    {
      "name": "unit",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Unit of the property (UN/CEFACT code recommended)."
    },
    {
      "name": "updated_at",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null,
      "doc": "Last change. Server-managed and volatile on every read (sim-v5 returns a fresh value per GET), so promotion:never — kept in the snapshot but excluded from the change-trigger and never published on its own."
    }
  ]
}
