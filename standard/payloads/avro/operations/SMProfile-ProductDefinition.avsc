        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "msgId",
      "type": "string",
      "doc": "Unique message id: the Kafka key, for deduplication."
    },
    {
      "name": "profileRef",
      "type": "string",
      "default": "SMProfile-ProductDefinition"
    },
    {
      "name": "profileVersion",
      "type": "string",
      "default": "2.1.0"
    },
    {
      "name": "b2m",
      "type": [
        "null",
        {
          "type": "record",
          "name": "B2M",
          "fields": [
            {
              "name": "verb",
              "type": {
                "type": "enum",
                "name": "B2MVerb",
                "symbols": [
                  "GET",
                  "SHOW",
                  "PROCESS",
                  "ACKNOWLEDGE",
                  "CHANGE",
                  "RESPOND",
                  "CANCEL",
                  "CONFIRM",
                  "SYNC"
                ]
              }
            },
            {
              "name": "actionCode",
              "type": [
                "null",
                {
                  "type": "enum",
                  "name": "B2MActionCode",
                  "symbols": [
                    "Add",
                    "Change",
                    "Delete",
                    "Replaced",
                    "Accepted",
                    "Modified",
                    "Rejected"
                  ]
                }
              ],
              "default": null
            }
          ]
        }
      ],
      "default": null
    },
    {
      "name": "data",
      "type": {
        "type": "record",
        "name": "ProductDefinitionData",
        "fields": [
          {
            "name": "product_definition_no",
            "type": "string",
            "doc": "Spec identity / key."
          },
          {
            "name": "name",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "Display name of the product specification."
          },
          {
            "name": "version_label",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "Functional spec/recipe version (independent of the profile SemVer)."
          },
          {
            "name": "status",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "Lifecycle status, e.g. draft, released, obsolete."
          },
          {
            "name": "article_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "FK to Article.article_no, reached via OperationsSegment SPECIFIES_MATERIAL. The article this spec defines — the production order / recipe join point. First binding axis."
          },
          {
            "name": "equipment_class_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "Optional FK to an EquipmentClass/line the spec is restricted to, reached via OperationsSegment SPECIFIES_EQUIPMENT. Second binding axis."
          },
          {
            "name": "setup_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "Optional setup/mould binding axis (third axis)."
          },
          {
            "name": "param_name",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "Name of the controlled product property (e.g. a speed, a thickness or a weight per area)."
          },
          {
            "name": "target_value",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Target / SOLL setpoint of the property."
          },
          {
            "name": "warn_lo",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Inner band lower limit (warning tier)."
          },
          {
            "name": "warn_hi",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Inner band upper limit (warning tier)."
          },
          {
            "name": "action_lo",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Outer band lower limit (action tier)."
          },
          {
            "name": "action_hi",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Outer band upper limit (action tier)."
          },
          {
            "name": "unit",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "Unit of the property (UN/CEFACT code recommended)."
          },
          {
            "name": "updated_at",
            "type": [
              "null",
              {
                "type": "long",
                "logicalType": "timestamp-millis"
              }
            ],
            "default": null,
            "doc": "Last change. Server-managed and volatile on every read (sim-v5 returns a fresh value per GET), so promotion:never — kept in the snapshot but excluded from the change-trigger and never published on its own."
          },
          {
            "name": "operations_type",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "ISA-95 operations type (B2MML OperationsType; Part 3/4: which MOM area the object belongs to; audit M1). A source without the column sets the constant of the profile's momDomain (columnMappings const)."
          },
          {
            "name": "characteristic_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The characteristic the band of this parameter comes from: the criterion of the test specification (SMProfile-TestSpecificationCriterion, e.g. the balloon number on the drawing). Empty until a real source names it — never invented."
          },
          {
            "name": "source_revision",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The revision of the drawing or document that set the band. Empty until a real source names it — never invented."
          }
        ]
      }
    }
  ]
