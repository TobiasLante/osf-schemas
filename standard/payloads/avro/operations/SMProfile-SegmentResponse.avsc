{
  "type": "record",
  "name": "SegmentResponse",
  "namespace": "org.openshopfloor.payload.operations",
  "doc": "GENERATED from standard/profiles/operations/segment-response.json 5.0.0 by i3x-v5 packages/schemas-ci/gen-payloads.mjs; do not edit by hand. Kafka value schema (TopicNameStrategy), the same shape as the JSON payload (envelope fields + data). Types: DateTime → long timestamp-millis (UTC), Int32/Int64 → long, Float/Double → double, Json → string (JSON text); key and required attributes are not nullable, the others [null, T] default null.",
  "fields": [
    {
      "name": "eventType",
      "type": {
        "type": "enum",
        "name": "EventType",
        "symbols": [
          "created",
          "updated",
          "deleted"
        ]
      }
    },
    {
      "name": "id",
      "type": "string",
      "doc": "Row key (segment_response_no); no + # * > / or space."
    },
    {
      "name": "entity",
      "type": "string",
      "default": "SegmentResponse"
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "msgId",
      "type": "string",
      "doc": "Unique message id: the Kafka key, for deduplication."
    },
    {
      "name": "profileRef",
      "type": "string",
      "default": "SMProfile-SegmentResponse"
    },
    {
      "name": "profileVersion",
      "type": "string",
      "default": "5.0.0"
    },
    {
      "name": "b2m",
      "type": [
        "null",
        {
          "type": "record",
          "name": "B2M",
          "fields": [
            {
              "name": "verb",
              "type": {
                "type": "enum",
                "name": "B2MVerb",
                "symbols": [
                  "GET",
                  "SHOW",
                  "PROCESS",
                  "ACKNOWLEDGE",
                  "CHANGE",
                  "RESPOND",
                  "CANCEL",
                  "CONFIRM",
                  "SYNC"
                ]
              }
            },
            {
              "name": "actionCode",
              "type": [
                "null",
                {
                  "type": "enum",
                  "name": "B2MActionCode",
                  "symbols": [
                    "Add",
                    "Change",
                    "Delete",
                    "Replaced",
                    "Accepted",
                    "Modified",
                    "Rejected"
                  ]
                }
              ],
              "default": null
            }
          ]
        }
      ],
      "default": null
    },
    {
      "name": "data",
      "type": {
        "type": "record",
        "name": "SegmentResponseData",
        "fields": [
          {
            "name": "segment_response_no",
            "type": "string",
            "doc": "Identity of the SegmentResponse (join key): its own number from the source system. It is never built from other keys; the operations response is reached through operations_response_ref (core 4.0.0, F3)."
          },
          {
            "name": "operations_response_ref",
            "type": "string",
            "doc": "FK to OperationsResponse.production_order_no (PART_OF). The order actuals to which these segment actuals belong."
          },
          {
            "name": "segment_requirement_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "FK to SegmentRequirement.segment_requirement_no (RESPONDS_TO). The target segment whose actuals are reported here."
          },
          {
            "name": "process_segment_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "FK to ProcessSegment.process_segment_no (FOR_PROCESS_SEGMENT). Which manufacturing stage was executed."
          },
          {
            "name": "sequence",
            "type": [
              "null",
              "long"
            ],
            "default": null,
            "doc": "Sequence of this segment within the order."
          },
          {
            "name": "material_lot_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "FK to MaterialLot.material_lot_no (ACTUAL_MATERIAL) = MaterialActual.MaterialLotID. The material lot actually consumed/produced; role via material_use."
          },
          {
            "name": "material_use",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "ISA-95 MaterialActual.MaterialUse — the ROLE of the material (actual). Mirrors the SegmentRequirement role."
          },
          {
            "name": "qty_actual",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Actual quantity of this material role (actual). Counterpart to SegmentRequirement.qty_planned."
          },
          {
            "name": "unit_of_measure",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "Unit of measure of qty_actual."
          },
          {
            "name": "equipment_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "FK to Machine.machine_id (ACTUAL_EQUIPMENT; Machine ≡ Unit level) = EquipmentActual.EquipmentID. The equipment actually used."
          },
          {
            "name": "actual_start_time",
            "type": [
              "null",
              {
                "type": "long",
                "logicalType": "timestamp-millis"
              }
            ],
            "default": null,
            "doc": "Actual stage start (actual)."
          },
          {
            "name": "actual_end_time",
            "type": [
              "null",
              {
                "type": "long",
                "logicalType": "timestamp-millis"
              }
            ],
            "default": null,
            "doc": "Actual stage end (actual)."
          },
          {
            "name": "status",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "Actual status of the stage (e.g. running, complete, aborted). Derived from the MES OrderState."
          },
          {
            "name": "qty_good",
            "type": [
              "null",
              "long"
            ],
            "default": null,
            "doc": "Good parts counted at the machine for the running order. Reported by the machine source through objects[] (owner 25.09.); history: docs/history/standard/profiles/operations/segment-response.md."
          },
          {
            "name": "qty_scrap",
            "type": [
              "null",
              "long"
            ],
            "default": null,
            "doc": "Scrap parts counted at the machine for the running order. Reported by the machine source through objects[] (owner 25.09.); history: docs/history/standard/profiles/operations/segment-response.md."
          },
          {
            "name": "qty_total",
            "type": [
              "null",
              "long"
            ],
            "default": null,
            "doc": "All parts (good + scrap) counted at the machine for the running order. Reported by the machine source through objects[] (owner 25.09.); history: docs/history/standard/profiles/operations/segment-response.md."
          },
          {
            "name": "program_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The NC or machine program the machine reports as active. Reported by the machine source through objects[] (owner 25.09.); history: docs/history/standard/profiles/operations/segment-response.md."
          },
          {
            "name": "tool_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The tool or mould the machine reports as set up for the order. Reported by the machine source through objects[] (owner 25.09.); history: docs/history/standard/profiles/operations/segment-response.md."
          },
          {
            "name": "qty_rework",
            "type": [
              "null",
              "long"
            ],
            "default": null,
            "doc": "Parts sent to rework, counted at the machine for the running order. Reported by the machine source through objects[] (owner 25.09.); history: docs/history/standard/profiles/operations/segment-response.md."
          },
          {
            "name": "production_order_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The production order the machine reports it is running. Reported by the machine source through objects[] (owner 25.09.); history: docs/history/standard/profiles/operations/segment-response.md."
          },
          {
            "name": "article_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The article the machine reports it is producing. Reported by the machine source through objects[] (owner 25.09.); history: docs/history/standard/profiles/operations/segment-response.md."
          },
          {
            "name": "article_revision",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The revision of the article that was built or used, where the source's article number carries none (a PLM part number with revision A). Empty when the number itself names the revision (at SAP dddd.1)."
          },
          {
            "name": "recipe_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The recipe the order ran with (its recipeId in sites/<site>/recipes)."
          },
          {
            "name": "recipe_version",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The released version (semver) of that recipe."
          },
          {
            "name": "program_line",
            "type": [
              "null",
              "long"
            ],
            "default": null,
            "doc": "The active line of the running program. Reported by the machine source through objects[] (owner 25.09.); history: docs/history/standard/profiles/operations/segment-response.md."
          },
          {
            "name": "program_status",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The state of the running program (running, stopped, …). Reported by the machine source through objects[] (owner 25.09.); history: docs/history/standard/profiles/operations/segment-response.md."
          },
          {
            "name": "equipment_class_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The EquipmentClass (ACTUAL_EQUIPMENT; ISA-95 SegmentResponse → EquipmentClass). Optional."
          },
          {
            "name": "material_class_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The MaterialClass (ACTUAL_MATERIAL; ISA-95 SegmentResponse → MaterialClass). Optional."
          },
          {
            "name": "quant_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The Quant (ACTUAL_MATERIAL; ISA-95 SegmentResponse → MaterialSubLot). Optional."
          },
          {
            "name": "person_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The Person (ACTUAL_PERSONNEL; ISA-95 SegmentResponse → Person). Optional."
          },
          {
            "name": "personnel_class_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The PersonnelClass (ACTUAL_PERSONNEL; ISA-95 SegmentResponse → PersonnelClass). Optional."
          },
          {
            "name": "physical_asset_class_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The PhysicalAssetClass (ACTUAL_PHYSICAL_ASSET; ISA-95 SegmentResponse → PhysicalAssetClass). Optional."
          },
          {
            "name": "job_response_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The JobResponse (DETAILED_BY; ISA-95 SegmentResponse → JobResponse). Optional."
          },
          {
            "name": "work_response_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The WorkResponse (DETAILED_BY; ISA-95 SegmentResponse → WorkResponse). Optional."
          },
          {
            "name": "operations_definition_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The OperationsDefinition (FOR_OPERATIONS_DEFINITION; ISA-95 SegmentResponse → OperationsDefinition). Optional."
          },
          {
            "name": "operations_definition_version",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The version of the operations definition this order / response ran with, where the source's definition id carries none (a routing number with its own change state). Empty when the id itself names the version."
          },
          {
            "name": "operations_segment_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The OperationsSegment (FOR_OPERATIONS_SEGMENT; ISA-95 SegmentResponse → OperationsSegment). Optional."
          },
          {
            "name": "inspection_lot_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The InspectionLot — the test result of a material actual (HAS_TEST_RESULT; ISA-95 SegmentResponse → MaterialActual → TestResult). Optional."
          },
          {
            "name": "personnel_test_result_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The TestResult of a person (qualification test) the response used (HAS_TEST_RESULT; ISA-95 SegmentResponse → PersonnelActual → TestResult). Optional."
          },
          {
            "name": "equipment_test_result_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The TestResult of a machine (equipment capability test) the response used (HAS_TEST_RESULT; ISA-95 SegmentResponse → EquipmentActual → TestResult). Optional."
          },
          {
            "name": "physical_asset_test_result_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The TestResult of a tool (physical asset capability test) the response used (HAS_TEST_RESULT; ISA-95 SegmentResponse → PhysicalAssetActual → TestResult). Optional."
          },
          {
            "name": "parent_segment_response_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The SegmentResponse this SegmentResponse is part of (PART_OF; ISA-95 SegmentResponse MADE_UP_OF SegmentResponse). Optional."
          },
          {
            "name": "source_quality",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "Quality the source reported for this record: the worst OPC UA StatusCode (Good / Uncertain / Bad) of the fields the edge read for it. Left out when the source reports none (ERP REST). A field of the record, not the telemetry quality facet (learning T10)."
          },
          {
            "name": "operations_type",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "ISA-95 operations type (B2MML OperationsType; Part 3/4: which MOM area the object belongs to; audit M1). A source without the column sets the constant of the profile's momDomain (columnMappings const)."
          }
        ]
      }
    }
  ]
}
