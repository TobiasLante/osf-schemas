        "type": "record",
        "name": "MaterialLotData",
        "fields": [
          {
            "name": "material_lot_no",
            "type": "string",
            "doc": "Identity of the material lot (join key). Often kept in the ERP as 'Charge/batch number' — here correctly as MaterialLot."
          },
          {
            "name": "article_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "FK to Article.article_no (DEFINED_BY) = MaterialLot.MaterialDefinitionID. The MaterialDefinition of this lot."
          },
          {
            "name": "article_revision",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The revision of the article that was built or used, where the source's article number carries none (a PLM part number with revision A). Empty when the number itself names the revision (at SAP dddd.1)."
          },
          {
            "name": "quantity",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Quantity of the lot."
          },
          {
            "name": "unit_of_measure",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "Unit of measure (UN/CEFACT code recommended)."
          },
          {
            "name": "status",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "Lot status (ISA-95 MaterialLotProperty / Status), e.g. available, in_production, consumed, blocked."
          },
          {
            "name": "workorder_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "FK to Workorder.workorder_no, reached via JobOrder REQUIRES_MATERIAL. The order slot that produced this lot."
