          },
          {
            "name": "location_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "FK to StorageLocation (AT_LOCATION). Current storage location of the lot."
          },
          {
            "name": "created_at",
            "type": [
              "null",
