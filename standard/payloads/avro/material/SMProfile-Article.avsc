{
  "type": "record",
  "name": "Article",
  "namespace": "org.openshopfloor.payload.material",
  "doc": "GENERATED from standard/profiles/material/article.json 2.4.0 by i3x-v5 packages/schemas-ci/gen-payloads.mjs; do not edit by hand. Kafka value schema (TopicNameStrategy), the same shape as the JSON payload (envelope fields + data). Types: DateTime → long timestamp-millis (UTC), Int32/Int64 → long, Float/Double → double, Json → string (JSON text); key and required attributes are not nullable, the others [null, T] default null.",
  "fields": [
    {
      "name": "eventType",
      "type": {
        "type": "enum",
        "name": "EventType",
        "symbols": [
          "created",
          "updated",
          "deleted"
        ]
      }
    },
    {
      "name": "id",
      "type": "string",
      "doc": "Row key (article_no); no + # * > / or space."
    },
    {
      "name": "entity",
      "type": "string",
      "default": "Article"
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "msgId",
      "type": "string",
      "doc": "Unique message id: the Kafka key, for deduplication."
    },
    {
      "name": "profileRef",
      "type": "string",
      "default": "SMProfile-Article"
    },
    {
      "name": "profileVersion",
      "type": "string",
      "default": "2.4.0"
    },
    {
      "name": "b2m",
      "type": [
        "null",
        {
          "type": "record",
          "name": "B2M",
          "fields": [
            {
              "name": "verb",
              "type": {
                "type": "enum",
                "name": "B2MVerb",
                "symbols": [
                  "GET",
                  "SHOW",
                  "PROCESS",
                  "ACKNOWLEDGE",
                  "CHANGE",
                  "RESPOND",
                  "CANCEL",
                  "CONFIRM",
                  "SYNC"
                ]
              }
            },
            {
              "name": "actionCode",
              "type": [
                "null",
                {
                  "type": "enum",
                  "name": "B2MActionCode",
                  "symbols": [
                    "Add",
                    "Change",
                    "Delete",
                    "Replaced",
                    "Accepted",
                    "Modified",
                    "Rejected"
                  ]
                }
              ],
              "default": null
            }
          ]
        }
      ],
      "default": null
    },
    {
      "name": "data",
      "type": {
        "type": "record",
        "name": "ArticleData",
        "fields": [
          {
            "name": "article_no",
            "type": "string"
          },
          {
            "name": "name",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "type",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "unit",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "lead_time_days",
            "type": [
              "null",
              "long"
            ],
            "default": null
          },
          {
            "name": "abc_class",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "cost_hk",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Standard manufacturing/purchase cost (HK = Herstellkosten), from ERP std_kosten. The €-basis for scrap / quality impact."
          },
          {
            "name": "price_vk",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Standard sales price (VK = Verkaufspreis), from ERP std_verkaufspreis. The basis for margin / lost-sales impact. Null for non-sellable articles (RAW/CONSUMABLE/WIP)."
          },
          {
            "name": "currency",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "ISO-4217 currency code for cost_hk / price_vk, from ERP waehrung (e.g. EUR)."
          },
          {
            "name": "stock_free",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Free (unblocked) stock of this article across all warehouses (menge_frei). Served by GET /api/articles, which is ARTICLE_WITH_STOCK_AND_PRICE_SQL. This is the article-level figure the WMS Quant rows sum to; a single Quant is one pallet/lot in one bin and is NOT a stock position."
          },
          {
            "name": "stock_reserved",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Quantity already committed to orders (menge_reserviert) — free stock that is spoken for."
          },
          {
            "name": "stock_blocked",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Quantity blocked / on hold (menge_blockiert)."
          },
          {
            "name": "stock_available",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "AVAILABLE-TO-PROMISE: free minus reserved (verfuegbar). Full text: docs/history/standard/profiles/material/article.md, attributes › stock_available › description."
          },
          {
            "name": "reorder_level",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Reorder level / Meldebestand from the ERP article master (mindestbestand). Full text: docs/history/standard/profiles/material/article.md, attributes › reorder_level › description."
          },
          {
            "name": "safety_stock",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Safety stock (safety_stock). Full text: docs/history/standard/profiles/material/article.md, attributes › safety_stock › description."
          },
          {
            "name": "material_class_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The material class this article belongs to (DEFINED_BY), e.g. PA66-GF30. Empty until the article master or a mapping supplies it."
          },
          {
            "name": "assembly_type",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "ISA-95 AssemblyType: Physical (the parts are physically joined) or Logical (a grouping, e.g. a compound of polymer and filler)."
          },
          {
            "name": "assembly_relationship",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "ISA-95 AssemblyRelationship: Permanent (cannot be taken apart again) or Transient (temporary, e.g. a kit)."
          },
          {
            "name": "test_specification_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The TestSpecification (TESTED_BY; ISA-95 MaterialDefinition → TestSpecification). Optional."
          },
          {
            "name": "revision",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The revision of the article as the source names it — at SAP the suffix of the material number (dddd.1, dddd.2), elsewhere the revision field of the part. Never derived from the number by the model."
          },
          {
            "name": "version",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The version within a revision (the second axis: iteration or processing state, e.g. A.3 in a PLM). Kept apart from the revision."
          },
          {
            "name": "base_article_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The article the revisions share (the stem dddd), as the source delivers it or by a rule declared on the source — the model never splits a number."
          },
          {
            "name": "effective_start",
            "type": [
              "null",
              {
                "type": "long",
                "logicalType": "timestamp-millis"
              }
            ],
            "default": null,
            "doc": "From when this article revision is valid (effectivity by date). An effectivity by serial number, lot or unit is no date and has no B2MML field (an extension of its own, PLAN-0700 L5)."
          },
          {
            "name": "effective_end",
            "type": [
              "null",
              {
                "type": "long",
                "logicalType": "timestamp-millis"
              }
            ],
            "default": null,
            "doc": "Until when this article revision is valid."
          },
          {
            "name": "published_date",
            "type": [
              "null",
              {
                "type": "long",
                "logicalType": "timestamp-millis"
              }
            ],
            "default": null,
            "doc": "When this article revision was released by the system that owns it."
          },
          {
            "name": "engineering_change_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The engineering change (ECN, SAP change number) that released this article revision."
          },
          {
            "name": "plm_part_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The part number of this article in PLM (e.g. a Windchill part) where it differs from the ERP number; empty when the source does not name it."
          }
        ]
      }
    }
  ]
}
