{
  "type": "record",
  "name": "Article",
  "x-kafka": {
    "contract": "Article",
    "key": "article_no",
    "topic": "<prefix>.{site}.Article",
    "strategy": "TopicNameStrategy"
  },
  "namespace": "org.openshopfloor.payload.material",
  "doc": "GENERATED from standard/profiles/material/article.json 3.1.0 by i3x-v5 packages/schemas-ci/gen-payloads.mjs; do not edit by hand. Kafka value schema (TopicNameStrategy), the same shape as the JSON payload (envelope fields + data). Types: DateTime → long timestamp-millis (UTC), Int32/Int64 → long, Float/Double → double, Json → string (JSON text); key and required attributes are not nullable, the others [null, T] default null.",
  "fields": [
    {
      "name": "eventType",
      "type": {
        "type": "enum",
        "name": "EventType",
        "symbols": [
          "created",
          "updated",
          "deleted"
        ]
      }
    },
    {
      "name": "id",
      "type": "string",
      "doc": "Row key (article_no); no + # * > / or space."
    },
    {
      "name": "entity",
      "type": "string",
      "default": "Article"
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "msgId",
      "type": "string",
      "doc": "Unique message id: the Nats-Msg-Id, for deduplication. The Kafka key is the entity's key, article_no (x-kafka)."
    },
    {
      "name": "profileRef",
      "type": "string",
      "default": "SMProfile-Article"
    },
    {
      "name": "profileVersion",
      "type": "string",
      "default": "3.1.0"
    },
    {
      "name": "b2m",
      "type": [
        "null",
        {
          "type": "record",
          "name": "B2M",
          "fields": [
            {
              "name": "verb",
              "type": {
                "type": "enum",
                "name": "B2MVerb",
                "symbols": [
                  "GET",
                  "SHOW",
                  "PROCESS",
                  "ACKNOWLEDGE",
                  "CHANGE",
                  "RESPOND",
                  "CANCEL",
                  "CONFIRM",
                  "SYNC"
                ]
              }
            },
            {
              "name": "actionCode",
              "type": [
                "null",
                {
                  "type": "enum",
                  "name": "B2MActionCode",
                  "symbols": [
                    "Add",
                    "Change",
                    "Delete",
                    "Replaced",
                    "Accepted",
                    "Modified",
                    "Rejected"
                  ]
                }
              ],
              "default": null
            }
          ]
        }
      ],
      "default": null
    },
    {
      "name": "data",
      "type": {
        "type": "record",
        "name": "ArticleData",
        "fields": [
          {
            "name": "article_no",
            "type": "string"
          },
          {
            "name": "name",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "type",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "unit",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "lead_time_days",
            "type": [
              "null",
              "long"
            ],
            "default": null
          },
          {
            "name": "abc_class",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "cost_hk",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Standard manufacturing/purchase cost (HK = Herstellkosten), from ERP std_kosten. The €-basis for scrap / quality impact."
          },
          {
            "name": "price_vk",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Standard sales price (VK = Verkaufspreis), from ERP std_verkaufspreis. The basis for margin / lost-sales impact. Null for non-sellable articles (RAW/CONSUMABLE/WIP)."
          },
          {
            "name": "currency",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "ISO-4217 currency code for cost_hk / price_vk, from ERP waehrung (e.g. EUR)."
          },
          {
            "name": "reorder_level",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Reorder level / Meldebestand from the ERP article master (mindestbestand). Full text: docs/history/standard/profiles/material/article.md, attributes › reorder_level › description."
          },
          {
            "name": "safety_stock",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Safety stock (safety_stock). Full text: docs/history/standard/profiles/material/article.md, attributes › safety_stock › description."
          },
          {
            "name": "material_class_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The material class this article belongs to (DEFINED_BY), e.g. PA66-GF30. Empty until the article master or a mapping supplies it."
          },
          {
            "name": "assembly_type",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "ISA-95 AssemblyType: Physical (the parts are physically joined) or Logical (a grouping, e.g. a compound of polymer and filler)."
          },
          {
            "name": "assembly_relationship",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "ISA-95 AssemblyRelationship: Permanent (cannot be taken apart again) or Transient (temporary, e.g. a kit)."
          },
          {
            "name": "test_specification_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The TestSpecification (TESTED_BY; ISA-95 MaterialDefinition → TestSpecification). Optional."
          },
          {
            "name": "revision",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The revision of the article as the source names it — at SAP the suffix of the material number (dddd.1, dddd.2), elsewhere the revision field of the part. Never derived from the number by the model."
          },
          {
            "name": "version",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The version within a revision (the second axis: iteration or processing state, e.g. A.3 in a PLM). Kept apart from the revision."
          },
          {
            "name": "base_article_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The article the revisions share (the stem dddd), as the source delivers it or by a rule declared on the source — the model never splits a number."
          },
          {
            "name": "effective_start",
            "type": [
              "null",
              {
                "type": "long",
                "logicalType": "timestamp-millis"
              }
            ],
            "default": null,
            "doc": "From when this article revision is valid (effectivity by date). An effectivity by serial number, lot or unit is no date and has no B2MML field (an extension of its own, PLAN-0700 L5)."
          },
          {
            "name": "effective_end",
            "type": [
              "null",
              {
                "type": "long",
                "logicalType": "timestamp-millis"
              }
            ],
            "default": null,
            "doc": "Until when this article revision is valid."
          },
          {
            "name": "published_date",
            "type": [
              "null",
              {
                "type": "long",
                "logicalType": "timestamp-millis"
              }
            ],
            "default": null,
            "doc": "When this article revision was released by the system that owns it."
          },
          {
            "name": "engineering_change_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The engineering change (ECN, SAP change number) that released this article revision."
          },
          {
            "name": "plm_part_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The part number of this article in PLM (e.g. a Windchill part) where it differs from the ERP number; empty when the source does not name it."
          },
          {
            "name": "supplier_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The supplier of the article as the ERP article master names it (lieferant_id)."
          },
          {
            "name": "primary_supplier_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The primary supplier of the article from the ERP purchasing data (primary_supplier_id). Full text: docs/history/standard/profiles/material/article.md, attributes › primary_supplier_ref › description."
          },
          {
            "name": "active",
            "type": [
              "null",
              "boolean"
            ],
            "default": null,
            "doc": "Whether the article is active in the ERP article master (aktiv)."
          },
          {
            "name": "replaced_by_ref",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The article that replaces this one, where the ERP article master names it (replaced_by)."
          },
          {
            "name": "deactivated_at",
            "type": [
              "null",
              {
                "type": "long",
                "logicalType": "timestamp-millis"
              }
            ],
            "default": null,
            "doc": "When the ERP deactivated the article (deactivated_at)."
          },
          {
            "name": "deactivated_reason",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "Why the ERP deactivated the article, in its words (deactivated_reason)."
          },
          {
            "name": "created_at",
            "type": [
              "null",
              {
                "type": "long",
                "logicalType": "timestamp-millis"
              }
            ],
            "default": null,
            "doc": "When the article was created in the ERP article master."
          },
          {
            "name": "updated_at",
            "type": [
              "null",
              {
                "type": "long",
                "logicalType": "timestamp-millis"
              }
            ],
            "default": null,
            "doc": "Last change of the article in the ERP article master."
          },
          {
            "name": "purchase_price",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Purchase price per unit of the article from the ERP purchasing data (einkaufspreis); empty for articles without one."
          },
          {
            "name": "weight_kg",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Weight of one unit of the article in kilograms, where the ERP article master names it (gewicht_kg)."
          },
          {
            "name": "mrp_type",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "MRP type of the ERP article master in its own codes (mrp_type)."
          },
          {
            "name": "procurement_type",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "Procurement type of the ERP article master in its own codes (procurement_type)."
          },
          {
            "name": "lot_size_procedure",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "Lot-sizing procedure of the ERP article master in its own codes (lot_size_proc)."
          },
          {
            "name": "min_lot_size",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Minimum lot size of the ERP article master, in the article's unit (min_lot_size)."
          },
          {
            "name": "max_lot_size",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Maximum lot size of the ERP article master, in the article's unit (max_lot_size)."
          },
          {
            "name": "rounding_value",
            "type": [
              "null",
              "double"
            ],
            "default": null,
            "doc": "Rounding value of the ERP article master: a lot is a multiple of it, in the article's unit (rounding_value)."
          },
          {
            "name": "batch_managed",
            "type": [
              "null",
              "boolean"
            ],
            "default": null,
            "doc": "Whether the ERP manages the article in batches (batch_managed)."
          },
          {
            "name": "serial_managed",
            "type": [
              "null",
              "boolean"
            ],
            "default": null,
            "doc": "Whether the ERP manages the article by serial number (serial_managed)."
          },
          {
            "name": "material_grade",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "The grade of the material within its material class as the ERP names it (material_grade), e.g. 42CrMo4."
          },
          {
            "name": "material_class_source",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "Where the ERP took the article's material class from, in its words (material_source), e.g. description:ABS."
          }
        ]
      }
    }
  ]
}
