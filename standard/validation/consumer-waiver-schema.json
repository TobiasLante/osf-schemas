{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://osf-schemas/validation/consumer-waiver-schema.json",
  "title": "Consumer Waiver",
  "description": "Meta-schema for sites/werk1/consumers/waivers/*.json. A signed waiver that exempts a set of sourceRefs from the consumer/feedback contract, with reason and signature.",
  "type": "object",
  "required": ["waiverId", "version", "sourceRefs", "reason", "signedBy", "signedAt"],
  "properties": {
    "waiverId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "reason": { "type": "string", "minLength": 1 },
    "signedBy": { "type": "string", "minLength": 1 },
    "signedAt": { "type": "string", "format": "date-time" }
  },
  "patternProperties": {
    "^\\$": { "type": "string" }
  },
  "additionalProperties": false
}
