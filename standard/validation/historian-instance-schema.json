{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://osf-schemas/validation/historian-instance-schema.json",
  "title": "Historian Instance",
  "description": "Meta-schema for sites/werk1/historians/instances/*.json. Declares a concrete historian-sink instance (edge or central) with its connection, tables, retention and compression policy.",
  "type": "object",
  "required": ["instanceId", "version", "kind", "tier", "displayName", "host", "database", "tables", "retention", "servedMachines", "machineTypes"],
  "properties": {
    "instanceId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
    "kind": { "type": "string", "minLength": 1 },
    "tier": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "ipcId": { "type": "string" },
    "host": { "type": "string", "minLength": 1 },
    "internalHost": { "type": "string" },
    "internalPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "nodePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "database": { "type": "string", "minLength": 1 },
    "user": { "type": "string" },
    "passwordSource": { "type": "string" },
    "natsDomain": { "type": "string" },
    "queryRoute": { "type": "object" },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind", "columns"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "retention": {
      "type": "object",
      "required": ["default"],
      "properties": {
        "default": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "compression": { "type": "object" },
    "servedMachines": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "machineTypes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "patternProperties": {
    "^\\$": { "type": "string" }
  },
  "additionalProperties": false
}
