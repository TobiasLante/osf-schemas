{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://osf-schemas/validation/cross-constraint-schema.json",
  "title": "CrossConstraint",
  "description": "Meta-schema for standard/cross-constraints/*.json. A cross-source discrepancy rule that compares TWO entities across a join key (PLAN vs IST). The op vocabulary lives HERE (properties.op.enum) and is the single source of truth — ci/lint-cross-constraints.mjs reads it from this file.",
  "type": "object",
  "required": [
    "crossConstraintId",
    "version",
    "standard",
    "displayName",
    "description",
    "severity",
    "discrepancyClass",
    "concern",
    "mom_category",
    "accountable_role",
    "left",
    "right",
    "op",
    "since",
    "impact_basis"
  ],
  "properties": {
    "crossConstraintId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "standard": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "severity": { "type": "string", "enum": ["warning", "error"] },
    "discrepancyClass": { "type": "string", "minLength": 1 },
    "concern": { "type": "string", "minLength": 1 },
    "mom_category": { "type": "string", "minLength": 1 },
    "accountable_role": { "type": "string", "minLength": 1 },
    "when": {
      "type": "object",
      "required": ["leftAttr"],
      "properties": {
        "leftAttr": { "type": "string", "minLength": 1 },
        "rightAttr": { "type": "string", "minLength": 1 },
        "eq": {},
        "ne": {}
      },
      "additionalProperties": false
    },
    "left": {
      "type": "object",
      "required": ["profileRef", "joinKey"],
      "properties": {
        "profileRef": { "type": "string", "minLength": 1 },
        "joinKey": { "type": "string", "minLength": 1 },
        "attr": { "type": "string", "minLength": 1 },
        "counterContract": { "type": "object" }
      },
      "patternProperties": { "^\\$": { "type": "string" } },
      "additionalProperties": false
    },
    "right": {
      "type": "object",
      "required": ["profileRef", "joinKey"],
      "properties": {
        "profileRef": { "type": "string", "minLength": 1 },
        "joinKey": { "type": "string", "minLength": 1 },
        "attr": { "type": "string", "minLength": 1 }
      },
      "patternProperties": { "^\\$": { "type": "string" } },
      "additionalProperties": false
    },
    "op": { "type": "string", "enum": ["lt", "lte", "gt", "gte", "eq", "ne"] },
    "aggregate": {
      "type": "object",
      "required": ["attr", "fn"],
      "properties": {
        "attr": { "type": "string", "minLength": 1 },
        "fn": { "type": "string", "minLength": 1 },
        "filter": {
          "type": "object",
          "properties": {
            "attr": { "type": "string", "minLength": 1 },
            "eq": {}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "threshold": { "type": "number" },
    "since": { "type": "string", "minLength": 1 },
    "impact_basis": { "type": "string", "minLength": 1 },
    "impactGuard": { "type": "string" },
    "version_note": { "type": "string" },
    "retired": { "type": "boolean" },
    "retiredAt": { "type": "string" },
    "retirementId": { "type": "string" },
    "retiredBy": { "type": "string" },
    "retiredReason": { "type": "string" },
    "retiredEvidence": { "type": "object" },
    "successor": { "type": "object" },
    "parked": { "type": "boolean" },
    "parkedAt": { "type": "string" },
    "parkedBy": { "type": "string" },
    "parkedReason": { "type": "string" },
    "blockedBy": { "type": "object" },
    "population": { "type": "object" },
    "findingShape": { "type": "object" },
    "confidence": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "retired": { "const": true } },
        "required": ["retired"]
      },
      "then": {
        "required": ["retiredAt", "retirementId", "retiredBy", "retiredReason", "successor"]
      }
    },
    {
      "if": {
        "properties": { "parked": { "const": true } },
        "required": ["parked"]
      },
      "then": {
        "required": ["parkedAt", "parkedBy", "parkedReason"]
      }
    }
  ],
  "patternProperties": {
    "^\\$": { "type": "string" }
  },
  "additionalProperties": false
}
