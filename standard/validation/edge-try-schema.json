{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://osf-schemas/next/validation/edge-try-schema.json",
  "title": "Edge contract · Try (read only)",
  "description": "Edge contract, part 3 (Welle 10, owner 25.09.): the read-only questions UNSaC asks an edge while a person tries a draft. READ and PAGE are the i3X v1 (CESMII) value and history calls — POST /v1/objects/value and POST /v1/objects/history — with elementId = the UNSaC signalId (<instance>/<property>); an edge that speaks i3X already answers them. REPLAY is a UNSaC extension (POST /v1/unsac/replay): recompute one rule over a window of history and return where it would have fired. Nothing is written. An edge that cannot answer an operation says so with 501; UNSaC then shows 'not supported by target <kind>'.",
  "oneOf": [
    {
      "$ref": "#/$defs/readRequest"
    },
    {
      "$ref": "#/$defs/readResponse"
    },
    {
      "$ref": "#/$defs/pageRequest"
    },
    {
      "$ref": "#/$defs/pageResponse"
    },
    {
      "$ref": "#/$defs/replayRequest"
    },
    {
      "$ref": "#/$defs/replayResponse"
    }
  ],
  "$defs": {
    "vqt": {
      "type": "object",
      "required": [
        "value",
        "quality",
        "timestamp"
      ],
      "properties": {
        "value": {},
        "quality": {
          "enum": [
            "Good",
            "GoodNoData",
            "Bad",
            "Uncertain"
          ]
        },
        "timestamp": {
          "type": "string",
          "description": "RFC 3339, UTC."
        }
      }
    },
    "readRequest": {
      "type": "object",
      "required": [
        "elementIds"
      ],
      "additionalProperties": false,
      "properties": {
        "elementIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "readResponse": {
      "type": "object",
      "required": [
        "success",
        "results"
      ],
      "properties": {
        "success": {
          "type": "boolean"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "success",
              "elementId"
            ],
            "properties": {
              "success": {
                "type": "boolean"
              },
              "elementId": {
                "type": "string"
              },
              "result": {
                "type": [
                  "object",
                  "null"
                ],
                "required": [
                  "value",
                  "quality",
                  "timestamp"
                ],
                "properties": {
                  "value": {},
                  "quality": {
                    "enum": [
                      "Good",
                      "GoodNoData",
                      "Bad",
                      "Uncertain"
                    ]
                  },
                  "timestamp": {
                    "type": "string"
                  },
                  "unit": {
                    "type": "string"
                  }
                }
              },
              "error": {
                "type": "object",
                "description": "Deprecated: the i3X v1 wire carries 'responseDetail'; an edge does not send 'error'."
              },
              "responseDetail": {
                "type": "object",
                "required": [
                  "status",
                  "detail"
                ],
                "description": "i3X v1 problem detail of a failed item (the edge's wire form).",
                "properties": {
                  "status": {
                    "type": "integer"
                  },
                  "title": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "description": "One item per requested elementId, in request order. success true = the edge answered for the signal ('result', a GoodNoData result with value null when it has no value). success false = a real failure; 'responseDetail' (i3X v1 problem detail) says why, detail never empty.",
            "allOf": [
              {
                "if": {
                  "properties": {
                    "success": {
                      "const": false
                    }
                  },
                  "required": [
                    "success"
                  ]
                },
                "then": {
                  "required": [
                    "responseDetail"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "pageRequest": {
      "type": "object",
      "required": [
        "elementIds",
        "startTime",
        "endTime"
      ],
      "additionalProperties": false,
      "properties": {
        "elementIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "startTime": {
          "type": "string"
        },
        "endTime": {
          "type": "string"
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "One page = one time window. The next page starts at the last timestamp of the previous one (i3X has no cursor)."
    },
    "pageResponse": {
      "type": "object",
      "required": [
        "success",
        "results"
      ],
      "properties": {
        "success": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean",
          "description": "true (HTTP 206) when the edge cut the window at its row cap; ask again from the last timestamp."
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "success",
              "elementId"
            ],
            "properties": {
              "success": {
                "type": "boolean"
              },
              "elementId": {
                "type": "string"
              },
              "result": {
                "type": [
                  "object",
                  "null"
                ],
                "required": [
                  "values"
                ],
                "properties": {
                  "values": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/vqt"
                    }
                  },
                  "lastBefore": {
                    "description": "Present when 'values' is empty: the last stored row of the signal before startTime (not changed in the window), or null when the signal was never written before startTime. Absent when the window has values.",
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "#/$defs/vqt"
                      }
                    ]
                  }
                }
              },
              "error": {
                "type": "object",
                "description": "Deprecated: the i3X v1 wire carries 'responseDetail'; an edge does not send 'error'."
              },
              "responseDetail": {
                "type": "object",
                "required": [
                  "status",
                  "detail"
                ],
                "description": "i3X v1 problem detail of a failed item (the edge's wire form).",
                "properties": {
                  "status": {
                    "type": "integer"
                  },
                  "title": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "description": "One item per requested elementId, in request order. success true = the edge answered for the signal: 'values' are the samples IN the window. Setpoints are written on change only (owner 26.09.), so an empty window is not an error: 'lastBefore' then says whether the signal was written before the window (its last row before startTime, i.e. the value held through the window) or never (null). success false = a real failure; 'responseDetail' (i3X v1 problem detail) says why, detail never empty.",
            "allOf": [
              {
                "if": {
                  "properties": {
                    "success": {
                      "const": false
                    }
                  },
                  "required": [
                    "success"
                  ]
                },
                "then": {
                  "required": [
                    "responseDetail"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "replayRequest": {
      "type": "object",
      "required": [
        "rule",
        "startTime",
        "endTime"
      ],
      "additionalProperties": false,
      "properties": {
        "rule": {
          "$ref": "https://osf-schemas/next/validation/constraint-schema.json#/$defs/constraint",
          "description": "The rule (a profile constraint) as the draft has it."
        },
        "instance": {
          "type": "string",
          "description": "The instance the rule is evaluated for."
        },
        "startTime": {
          "type": "string"
        },
        "endTime": {
          "type": "string"
        },
        "recipeValues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "description": "The values the rule's require.valueFrom (recipe:<key> / definition:<key>) takes over time, as UNSaC knows them from the model (the instance's machine settings, sites/<site>/settings). The edge keeps no recipe values of its own: the live detector gets them the same way, as a band handed to it (constraint generator cd_recipe_bands, delivered on i3x.recipe.band.<ipc>), and applies the numbers unchanged. Entries are ordered by from; an entry holds from its from until the next entry. A sample that no entry covers, or that falls under value null, has no right-hand side: it is not judged, gets no verdict and is counted in replayResponse.unresolved — never judged as inside the band. Only for a rule whose require has valueFrom.",
          "items": {
            "type": "object",
            "required": [
              "valueFrom",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "valueFrom": {
                "type": "string",
                "pattern": "^(recipe|definition):[A-Za-z0-9_.-]+$",
                "description": "Must equal rule.require.valueFrom."
              },
              "from": {
                "type": "string",
                "description": "RFC-3339 time the value holds from. Absent = holds from before the window (only the first entry may omit it)."
              },
              "value": {
                "description": "The right-hand side as the live detector would be handed it: [lo, hi] for op between, {warn:[lo,hi], action:[lo,hi]} for op within_limits, an array for op in, a literal otherwise. null = not known from this entry's from on."
              },
              "source": {
                "type": "string",
                "description": "Where the value comes from (e.g. the settings file and its version), for the reader. The edge does not interpret it."
              }
            }
          }
        }
      },
      "x-extension": "UNSaC extension of i3X v1"
    },
    "replayResponse": {
      "type": "object",
      "required": [
        "evaluated",
        "verdicts"
      ],
      "properties": {
        "evaluated": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of values the rule was evaluated on (values whose right-hand side was known; see unresolved)."
        },
        "verdicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at",
              "state"
            ],
            "properties": {
              "at": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "raised",
                  "cleared"
                ]
              },
              "value": {}
            }
          }
        },
        "unresolved": {
          "type": "object",
          "required": [
            "valueFrom",
            "count",
            "spans"
          ],
          "additionalProperties": false,
          "description": "Present when rule.require has valueFrom: the in-window values that were NOT judged because the right-hand side was not known at their time (no recipeValues entry, or value null). evaluated + unresolved.count = all in-window values with a value.",
          "properties": {
            "valueFrom": {
              "type": "string"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "spans": {
              "type": "array",
              "description": "Consecutive unresolved values, first and last timestamp of each run.",
              "items": {
                "type": "object",
                "required": [
                  "from",
                  "to"
                ],
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "x-extension": "UNSaC extension of i3X v1"
    }
  }
}
