{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://osf-schemas/validation/unit-conversions-schema.json",
  "title": "Unit Conversions",
  "description": "Meta-schema for standard/unit-conversions/conversions.json. Defines the shape of the unit conversion table used by the discovery pipeline.",
  "type": "object",
  "required": ["version", "conversions"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "updated": {
      "type": "string"
    },
    "conversions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from", "to", "scale", "offset"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "scale": { "type": "number" },
          "offset": { "type": "number" },
          "formula": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "patternProperties": {
    "^\\$": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
