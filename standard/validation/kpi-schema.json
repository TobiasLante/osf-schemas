{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://osf-schemas/validation/kpi-schema.json",
  "title": "KPI",
  "description": "Meta-schema for standard/kpis/*.json. Defines the shape of a KPI definition (inputs, per-profile input mappings, Cypher calculation, thresholds, applicable profiles) consumed by the KPI linter and the edge KPI flow generator.",
  "type": "object",
  "required": ["kpiId", "version", "displayName", "description", "unit", "category", "calculation", "thresholds", "appliesTo"],
  "properties": {
    "kpiId": { "type": "string", "pattern": "^KPI-" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "unit": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "calculation": {
      "type": "object",
      "required": ["inputs", "inputMappings", "cypher"],
      "properties": {
        "inputs": { "type": "array", "items": { "type": "string" } },
        "inputMappings": { "type": "object" },
        "cypher": { "type": "string" }
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "required": ["target", "warning", "critical"],
      "properties": {
        "target": { "type": "number" },
        "warning": { "type": "number" },
        "critical": { "type": "number" }
      },
      "additionalProperties": false
    },
    "appliesTo": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^SMProfile-" }
    },
    "parked": { "type": "boolean" },
    "parkedAt": { "type": "string" },
    "parkedReason": { "type": "string" }
  },
  "if": {
    "properties": { "parked": { "const": true } },
    "required": ["parked"]
  },
  "then": {
    "required": ["parkedAt", "parkedReason"]
  },
  "patternProperties": {
    "^\\$": { "type": "string" }
  },
  "additionalProperties": false
}
