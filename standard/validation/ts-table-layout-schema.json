{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://osf-schemas/validation/ts-table-layout-schema.json",
  "title": "TS Table Layout",
  "description": "Meta-schema for standard/historians/central-ts-tables/*.json. Declarative per-MachineType table-shape consumed by render-ddl.py to emit CREATE TABLE + hypertable + indexes + retention idempotently. Each table strictly telemetry XOR event XOR child.",
  "type": "object",
  "required": ["layoutId", "version", "machineType", "profileRef", "tables"],
  "properties": {
    "layoutId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
    "machineType": { "type": "string", "minLength": 1 },
    "profileRef": { "type": "string", "pattern": "^SMProfile-" },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "primaryKey", "columns"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "primaryKey": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": true
            }
          },
          "indexes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "columns"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "columns": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "patternProperties": {
    "^\\$": { "type": "string" }
  },
  "additionalProperties": false
}
