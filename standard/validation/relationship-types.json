  "_note": "Edge types that are the inverse of each other. i3X 1.0 requires every relationship type to register exactly one reverseOf. Where both directions are authored (in two profiles), they must be registered here as a pair, so the two sides cannot drift apart. Checked by ci/lint-edge-pairs.mjs.",
  "pairs": [],
  "_inversesNote": "inverses: the ISA-95 name of the other direction of an edge (IEC 62264 / B2MML catalogue: MADE_UP_OF ↔ PART_OF, DEFINED_BY ↔ DEFINITION_OF, IMPLEMENTED_BY ↔ IMPLEMENTATION_OF). Unlike pairs, neither side has to be authored on every edge; i3x/relationship-types.json takes reverseOf from here instead of generating *_REVERSE (owner 25.09.).",
  "inverses": [
    [
      "MADE_UP_OF",
      "PART_OF"
    ],
    [
      "DEFINED_BY",
      "DEFINITION_OF"
    ],
    [
      "IMPLEMENTED_BY",
      "IMPLEMENTATION_OF"
    ]
  ],
  "open": [],
