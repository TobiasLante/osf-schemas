            "x-delivery": "transactional",
            "x-scope": "hub",
            "x-promotion": "on_change",
            "x-quality": {
              "onBad": "flag"
            }
          },
          "status": {
            "type": "string",
            "description": "Actual status of the confirmation. Full text: docs/history/standard/profiles/erp/operations-response.md, attributes › status › description.",
