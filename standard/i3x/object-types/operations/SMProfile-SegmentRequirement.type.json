      "propertyMap": {
        "segment_requirement_no": "OperationsRequest.SegmentRequirement.ID",
        "production_order_ref": "OperationsRequest.ID",
        "process_segment_ref": "OperationsRequest.SegmentRequirement.ProcessSegmentID",
        "material_ref": "OperationsRequest.SegmentRequirement.MaterialRequirement.MaterialDefinitionID",
        "material_use": "OperationsRequest.SegmentRequirement.MaterialRequirement.MaterialUse",
        "qty_planned": "OperationsRequest.SegmentRequirement.MaterialRequirement.Quantity",
        "equipment_ref": "OperationsRequest.SegmentRequirement.EquipmentRequirement.EquipmentID",
        "planned_start_time": "OperationsRequest.SegmentRequirement.EarliestStartTime",
        "planned_end_time": "OperationsRequest.SegmentRequirement.LatestEndTime"
      }
    },
    "kgNodeLabel": "SegmentRequirement",
