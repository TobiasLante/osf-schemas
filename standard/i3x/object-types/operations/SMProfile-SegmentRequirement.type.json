        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change",
        "x-valueType": "ID"
      },
      "material_use": {
        "type": "string",
        "description": "ISA-95 MaterialRequirement.MaterialUse — the ROLE of the material in this stage. Encodes the 'Being Consumed/Produced/Tested/Moved'.",
        "enum": [
          "Consumed",
          "Produced",
          "Consumable",
          "ByProduct",
          "Sample",
          "MovedFrom",
          "MovedTo"
        ],
        "x-category": "Core",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "qty_planned": {
        "type": "number",
        "description": "Planned quantity of this material role (target). Counterpart to SegmentResponse.qty_actual.",
