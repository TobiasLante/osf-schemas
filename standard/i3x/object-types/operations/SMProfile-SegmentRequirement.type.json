        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change",
        "x-valueType": "ID"
      },
      "production_order_ref": {
        "type": "string",
        "description": "FK to ProductionOrder.production_order_no (PART_OF). The OperationsRequest to which this segment target belongs.",
        "x-category": "Link",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change",
        "x-valueType": "ID"
      },
      "process_segment_ref": {
        "type": "string",
        "description": "FK to ProcessSegment.process_segment_no (FOR_PROCESS_SEGMENT). Which manufacturing stage (= plant = Function) is planned here.",
        "x-category": "Link",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change",
        "x-valueType": "ID"
      },
      "sequence": {
        "type": "integer",
        "description": "Sequence of this segment within the order.",
        "x-dataType": "Int32",
        "x-category": "Planning",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "material_ref": {
        "type": "string",
        "description": "FK to Article.article_no (REQUIRES_MATERIAL) = MaterialRequirement.MaterialDefinitionID. The target material of this stage.",
