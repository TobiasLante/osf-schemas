        "x-category": "Planning",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "unit_of_measure": {
        "type": "string",
        "description": "Unit of measure of qty_planned (UN/CEFACT code recommended).",
        "x-category": "Planning",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "equipment_ref": {
        "type": "string",
        "description": "FK to Machine.machine_id (REQUIRES_EQUIPMENT; Machine ≡ Unit level) = EquipmentRequirement.EquipmentID. The target equipment of the stage.",
        "x-category": "Link",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change",
        "x-valueType": "ID"
      },
      "planned_start_time": {
        "type": "string",
        "format": "date-time",
        "description": "Planned stage start (target).",
        "x-dataType": "DateTime",
        "x-category": "Timing",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "planned_end_time": {
        "type": "string",
        "format": "date-time",
        "description": "Planned stage end (target).",
        "x-dataType": "DateTime",
        "x-category": "Timing",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      }
