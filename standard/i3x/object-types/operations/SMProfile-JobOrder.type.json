{
  "elementId": "SMProfile-JobOrder",
  "displayName": "Job Order (dispatched job on one machine)",
  "namespaceUri": "urn:osf:schemas:operations",
  "version": "1.0.0",
  "schema": {
    "description": "Level-3 MOM JobOrder (ISA-95 Part 4 / B2MML JobOrder): the job of one machine within a Workorder (WorkRequest), with the material lot it requires or produces. No source yet — fed in the sim-v5 wave (operations carry no lot link in sim-v5 today).",
    "type": "object",
    "properties": {
      "job_order_no": {
        "type": "string",
        "description": "Identity of the JobOrder (join key). Recommendation: <workorder_no>.<operation_no>.",
        "x-category": "Core",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change",
        "x-valueType": "ID"
      },
      "workorder_ref": {
        "type": "string",
        "description": "The Workorder (WorkRequest) this job belongs to.",
        "x-category": "Core",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change",
        "x-valueType": "ID"
      },
      "machine_ref": {
        "type": "string",
        "description": "The machine (Equipment) the job runs on.",
        "x-category": "Core",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change",
        "x-valueType": "ID"
      },
      "material_lot_ref": {
        "type": "string",
        "description": "The material lot the job requires or produces.",
        "x-category": "Core",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change",
        "x-valueType": "ID"
      },
      "material_use": {
        "type": "string",
        "description": "Whether the lot is consumed or produced by the job.",
        "enum": [
          "Consumed",
          "Produced"
        ],
        "x-category": "Core",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "start_planned": {
        "type": "string",
        "format": "date-time",
        "description": "Planned start of the job.",
        "x-dataType": "DateTime",
        "x-category": "Planning",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "end_planned": {
        "type": "string",
        "format": "date-time",
        "description": "Planned end of the job.",
        "x-dataType": "DateTime",
        "x-category": "Planning",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "status": {
        "type": "string",
        "description": "Dispatch state of the job as the source names it.",
        "x-category": "Core",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      }
    },
    "required": [
      "job_order_no",
      "workorder_ref"
    ]
  },
  "x-osf": {
    "source": "standard/profiles/operations/job-order.json",
    "standard": "ISA-95",
    "category": "business",
    "abstract": false,
    "relationships": [
      {
        "type": "PART_OF",
        "target": "Workorder",
        "targetIdProp": "workorder_no",
        "description": "The Workorder this job is part of (ISA-95: WorkRequest MADE_UP_OF JobOrder)."
      },
      {
        "type": "REQUIRES_EQUIPMENT",
        "target": "Machine",
        "targetIdProp": "machine_id",
        "description": "The machine the job runs on (B2MML EquipmentRequirement)."
      },
      {
        "type": "REQUIRES_MATERIAL",
        "target": "MaterialLot",
        "targetIdProp": "lot_no",
        "description": "The lot the job consumes or produces (B2MML MaterialRequirement, material_use)."
      }
    ],
    "constraints": [],
    "semantics": [
      "iso:62264-JobOrder"
    ],
    "kpiRefs": [],
    "isa95": {
      "objectModel": "JobOrder",
      "part": 4,
      "momDomain": "production",
      "level": 3,
      "note": "ISA-95 Part 4 JobOrder = one dispatched job of a WorkRequest. The MaterialLot link now runs both ways through JobOrder REQUIRES_MATERIAL (owner 25.09.).",
      "propertyMap": {
        "job_order_no": "JobOrder.ID",
        "machine_ref": "JobOrder.EquipmentRequirement.EquipmentID",
        "material_lot_ref": "JobOrder.MaterialRequirement.MaterialLotID",
        "material_use": "JobOrder.MaterialRequirement.MaterialUse",
        "start_planned": "JobOrder.StartTime",
        "end_planned": "JobOrder.EndTime",
        "status": "JobOrder.DispatchStatus"
      },
      "notInIsa95": [
        "workorder_ref"
      ],
      "mappingNote": "The parent WorkRequest is carried by B2MML through the nesting of JobOrder in WorkRequest, not as a field."
    },
    "kgNodeLabel": "JobOrder",
    "kgIdProperty": "job_order_no",
    "parentType": null,
    "requiredDeclaredOn": [
      "job_order_no",
      "workorder_ref",
      "machine_ref",
      "material_lot_ref",
      "material_use",
      "start_planned",
      "end_planned",
      "status"
    ]
  }
}
