{
  "kpiId": "KPI-Quality-Rate",
  "version": "3.1.0",
  "displayName": "Quality Rate",
  "description": "Percentage of good parts out of (good + scrap), computed live on the edge over the CURRENT counter values (IMM counters are cumulative_resettable — this is a since-last-reset ratio, not a shift window; windowed truth lives in … Full text: docs/history/standard/kpis/quality-rate.md, description.",
  "unit": "%",
  "category": "quality",
  "calculation": {
    "inputs": [
      "part_good",
      "part_scrap"
    ],
    "inputMappings": {
      "SMProfile-InjectionMoldingMachine": {
        "qty_good": "part_good",
        "qty_scrap": "part_scrap"
      },
      "SMProfile-CNC-Machine": {
        "qty_good": "part_good",
        "qty_scrap": "part_scrap"
      }
    },
    "cypher": "CASE WHEN (m.part_good + m.part_scrap) = 0 THEN null ELSE round(toFloat(m.part_good) / (m.part_good + m.part_scrap) * 1000) / 10 END",
    "expression": {
      "if": {
        "compare": "=",
        "args": [
          {
            "op": "+",
            "args": [
              {
                "input": "part_good"
              },
              {
                "input": "part_scrap"
              }
            ]
          },
          {
            "number": 0
          }
        ]
      },
      "then": {
        "empty": true
      },
      "else": {
        "round": {
          "op": "*",
          "args": [
            {
              "op": "/",
              "args": [
                {
                  "input": "part_good"
                },
                {
                  "op": "+",
                  "args": [
                    {
                      "input": "part_good"
                    },
                    {
                      "input": "part_scrap"
                    }
                  ]
                }
              ]
            },
            {
              "number": 100
            }
          ]
        },
        "digits": 1
      }
    }
  },
  "thresholds": {
    "target": 99,
    "warning": 95,
    "critical": 90
  },
  "appliesTo": [
    "SMProfile-Machine"
  ]
}
