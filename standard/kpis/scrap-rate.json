{
  "kpiId": "KPI-Scrap-Rate",
  "version": "3.3.0",
  "displayName": "Scrap Rate",
  "description": "Percentage of scrap parts out of (good + scrap), computed live on the edge over the CURRENT counter values (since-last-reset ratio — IMM counters are cumulative_resettable; windowed truth lives in the oee-hourly continuous aggregate). Full text: docs/history/standard/kpis/scrap-rate.md, description.",
  "unit": "%",
  "category": "quality",
  "calculation": {
    "inputs": [
      "part_good",
      "part_scrap"
    ],
    "inputMappings": {
      "SMProfile-InjectionMoldingMachine": {
        "Act_Amount_LifeTimeGood": "part_good",
        "Act_Amount_LifeTimeScrap": "part_scrap"
      },
      "SMProfile-CNC-Machine": {
        "Act_Amount_LifeTimeGood": "part_good",
        "Act_Amount_LifeTimeScrap": "part_scrap"
      }
    },
    "cypher": "CASE WHEN (m.part_good + m.part_scrap) = 0 THEN null ELSE round(toFloat(m.part_scrap) / (m.part_good + m.part_scrap) * 1000) / 10 END",
    "expression": {
      "if": {
        "compare": "=",
        "args": [
          {
            "op": "+",
            "args": [
              {
                "input": "part_good"
              },
              {
                "input": "part_scrap"
              }
            ]
          },
          {
            "number": 0
          }
        ]
      },
      "then": {
        "empty": true
      },
      "else": {
        "round": {
          "op": "*",
          "args": [
            {
              "op": "/",
              "args": [
                {
                  "input": "part_scrap"
                },
                {
                  "op": "+",
                  "args": [
                    {
                      "input": "part_good"
                    },
                    {
                      "input": "part_scrap"
                    }
                  ]
                }
              ]
            },
            {
              "number": 100
            }
          ]
        },
        "digits": 1
      }
    }
  },
  "thresholds": {
    "target": 1,
    "warning": 3,
    "critical": 5
  },
  "appliesTo": [
    "SMProfile-Machine"
  ]
}
