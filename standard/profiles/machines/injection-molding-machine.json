  "constraints": [
    {
      "name": "recipe_hotrunner_temp_band",
      "description": "Recipe / setting parameter: hot-runner temperature must lie within the target band (resolved at runtime via valueFrom recipe:hotrunner_temp_band). Full text: docs/history/standard/profiles/machines/injection-molding-machine.md, constraints › recipe_hotrunner_temp_band › description.",
      "require": {
        "attr": "hotrunnerTempC",
        "op": "between",
        "valueFrom": "recipe:hotrunner_temp_band"
      },
      "severity": "warning",
      "discrepancyClass": "constraint",
      "persistence": {
        "raise": {
          "k": 2,
          "of": 3
        },
        "clear": {
          "deadband_pct": 0.15,
          "consecutive": 3
        }
      },
      "concern": "operations",
      "mom_category": "quality",
      "accountable_role": "Process Engineering",
      "deviation_class": "recipe",
      "since": "2026-06-17",
      "impact_basis": "HK"
    },
    {
      "name": "recipe_part_mass_band",
