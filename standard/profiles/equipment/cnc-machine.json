  "constraints": [
    {
      "name": "spindle_load_control_limits",
      "description": "Control limits (warning and action limits) for spindle load %. Full text: docs/history/standard/profiles/equipment/cnc-machine.md, constraints › spindle_load_control_limits › description.",
      "require": {
        "attr": "Act_Pct_SpindleLoad",
        "op": "within_limits",
        "limits": {
          "warn": [
            0,
            55
          ],
          "action": [
            0,
            70
          ]
        }
      },
      "severity": "warning",
      "discrepancyClass": "control_limit",
      "persistence": {
        "raise": {
          "k": 2,
          "of": 3
        },
        "clear": {
          "deadband_pct": 0.15,
          "consecutive": 3
        }
      },
      "concern": "operations",
      "mom_category": "production",
      "accountable_role": "Production",
      "deviation_class": "equipment",
      "since": "2026-06-30"
    },
    {
      "name": "spindle_temp_control_limits",
      "description": "Control limits (warning and action limits) for spindle temperature degC. Full text: docs/history/standard/profiles/equipment/cnc-machine.md, constraints › spindle_temp_control_limits › description.",
      "require": {
        "attr": "Act_Temp_Spindle",
        "op": "within_limits",
        "limits": {
          "warn": [
            15,
            45
          ],
          "action": [
            10,
            55
          ]
        }
      },
      "severity": "warning",
      "discrepancyClass": "control_limit",
      "persistence": {
        "raise": {
          "k": 2,
          "of": 3
        },
        "clear": {
          "deadband_pct": 0.15,
          "consecutive": 3
        }
      },
      "concern": "operations",
      "mom_category": "production",
      "accountable_role": "Maintenance",
      "deviation_class": "equipment",
      "since": "2026-06-30"
    },
    {
      "name": "spindle_power_control_limits",
      "description": "Control limits (warning and action limits) for active power kW. Full text: docs/history/standard/profiles/equipment/cnc-machine.md, constraints › spindle_power_control_limits › description.",
      "require": {
        "attr": "Act_Power_Machine",
        "op": "within_limits",
        "limits": {
          "warn": [
            0,
            45
          ],
          "action": [
            0,
            55
          ]
        }
      },
      "severity": "warning",
      "discrepancyClass": "control_limit",
      "persistence": {
        "raise": {
          "k": 2,
          "of": 3
        },
        "clear": {
          "deadband_pct": 0.15,
          "consecutive": 3
        }
      },
      "concern": "operations",
      "mom_category": "production",
      "accountable_role": "Production",
      "deviation_class": "equipment",
      "since": "2026-06-30"
    },
    {
      "name": "spindle_when_in_cycle",
      "description": "Machining cycle is running but the spindle is not turning — tool break / spindle-motor fault / controller bug.",
      "when": {
        "attr": "Act_State_InCycle",
        "op": "eq",
        "value": true
      },
      "require": {
        "attr": "Act_Speed_Spindle",
        "op": "gt",
        "value": 0
      },
      "severity": "error",
      "discrepancyClass": "constraint",
      "concern": "operations",
      "mom_category": "production",
      "accountable_role": "Production",
      "deviation_class": "equipment",
      "since": "2026-06-08"
    },
    {
      "name": "coolant_pressure_when_in_cycle",
      "description": "Machining cycle is running without coolant pressure — risk of workpiece / tool damage.",
      "when": {
        "attr": "Act_State_InCycle",
        "op": "eq",
        "value": true
      },
      "require": {
        "attr": "Act_Pressure_Coolant",
        "op": "gt",
        "value": 0
      },
      "severity": "error",
      "discrepancyClass": "constraint",
      "concern": "operations",
      "mom_category": "production",
      "accountable_role": "Maintenance",
      "deviation_class": "equipment",
      "since": "2026-06-08"
    },
    {
      "name": "tool_wear_in_range",
      "description": "Tool wear must lie between 0 and 100 percent — values outside indicate a sensor / scaling fault. Full text: docs/history/standard/profiles/equipment/cnc-machine.md, constraints › tool_wear_in_range › description.",
      "require": {
        "attr": "Act_Pct_ToolWear",
        "op": "between",
        "value": [
          0,
          100
        ]
      },
      "severity": "warning",
      "discrepancyClass": "constraint",
      "persistence": {
        "raise": {
          "k": 2,
          "of": 3
        },
        "clear": {
          "deadband_pct": 0.15,
          "consecutive": 3
        }
      },
      "concern": "operations",
      "mom_category": "production",
      "accountable_role": "Maintenance",
      "deviation_class": "equipment",
      "since": "2026-06-08"
    },
    {
      "name": "power_positive_when_running",
      "description": "Machine reports status=RUNNING but draws 0 kW — sensor / edge-communication fault (equipment).",
      "when": {
        "attr": "Act_Status_Machine",
        "op": "eq",
        "value": "RUNNING"
      },
      "require": {
        "attr": "Act_Power_Machine",
        "op": "gt",
        "value": 0
      },
      "severity": "warning",
      "discrepancyClass": "constraint",
      "concern": "operations",
      "mom_category": "maintenance",
      "accountable_role": "Maintenance",
      "deviation_class": "equipment",
      "since": "2026-06-25"
    }
  ],
