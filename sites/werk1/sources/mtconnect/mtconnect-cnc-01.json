{
 "sourceId": "mtconnect-cnc-01",
 "version": "3.0.0",
 "sourceType": "mtconnect",
 "syncType": "polling",
 "transport": [
  "opcua-server"
 ],
 "description": "INGRESS descriptor for the MTConnect Sonder-Edge. Full text: docs/history/sites/werk1/sources/mtconnect/mtconnect-cnc-01.md, description.",
 "connection": { "endpoint": "http://192.168.178.154:35000", "device": "cnc-01", "agentVersion": "1.7", "auth": "Anonymous" },
 "dataCategory": "telemetry",
 "profileRef": "SMProfile-CNC-Machine",
 "instanceRef": "cnc-mtc-01",
 "machineId": "cnc-mtc-01",
 "machineName": "CNC-01 (MTConnect / Heidenhain-class)",
 "location": { "enterprise": "factory", "site": "werk1", "area": "cnc", "line": "line-mtc", "type": "CNC" },
 "dataItemMappings": [
  { "dataItemId": "cnc-01-spindle-speed", "category": "SAMPLE", "smAttribute": "Act_Speed_Spindle", "dataType": "Float", "unit": "RPM" },
  { "dataItemId": "cnc-01-spindle-load", "category": "SAMPLE", "smAttribute": "Act_Pct_SpindleLoad", "dataType": "Float", "unit": "P1" },
  { "dataItemId": "cnc-01-spindle-temp", "category": "SAMPLE", "smAttribute": "Act_Temp_Spindle", "dataType": "Float", "unit": "CEL" },
  { "dataItemId": "cnc-01-power", "category": "SAMPLE", "smAttribute": "Act_Energy_Power", "dataType": "Float", "unit": "KWT" },
  { "dataItemId": "cnc-01-x-pos", "category": "SAMPLE", "smAttribute": "Act_Pos_AxisX", "dataType": "Float", "unit": "MMT" },
  { "dataItemId": "cnc-01-y-pos", "category": "SAMPLE", "smAttribute": "Act_Pos_AxisY", "dataType": "Float", "unit": "MMT" },
  { "dataItemId": "cnc-01-z-pos", "category": "SAMPLE", "smAttribute": "Act_Pos_AxisZ", "dataType": "Float", "unit": "MMT" },
  { "dataItemId": "cnc-01-x-feed", "category": "SAMPLE", "smAttribute": "Act_Rate_Feed", "dataType": "Float", "unit": "H81" },
  {
   "dataItemId": "cnc-01-tool-life",
   "category": "SAMPLE",
   "smAttribute": "Act_Pct_ToolWear",
   "dataType": "Float",
   "unit": "P1",
   "_note": "MTConnect TOOL_LIFE is remaining-life %; mapped to Act_Pct_ToolWear for the demo (semantic inversion documented, not corrected)."
  },
  { "dataItemId": "cnc-01-mode", "category": "EVENT", "smAttribute": "Act_Text_MachineMode", "dataType": "String" },
  {
   "dataItemId": "cnc-01-exec",
   "category": "EVENT",
   "smAttribute": "Act_State_InCycle",
   "dataType": "Boolean",
   "valueMap": { "ACTIVE": true, "*": false },
   "_note": "Derived: execution==ACTIVE -> InCycle true."
  },
  {
   "dataItemId": "cnc-01-exec",
   "category": "EVENT",
   "smAttribute": "Act_Status_Machine",
   "dataType": "String",
   "valueMap": { "ACTIVE": "RUNNING", "*": "IDLE" },
   "_note": "Derived status, aligned with the sim-v5 String vocabulary (profile contract): execution==ACTIVE -> RUNNING, else IDLE."
  },
  {
   "dataItemId": "cnc-01-alarm",
   "category": "CONDITION",
   "smAttribute": "Act_Amount_Alarm",
   "dataType": "Int32",
   "valueMap": { "Normal": 0, "Warning": 1, "Fault": 1, "*": 0 },
   "_note": "MTConnect CONDITION -> alarm count (Fault/Warning -> 1)."
  }
 ],
 "polling": { "mode": "sample", "intervalMs": 2000 },
 "objects": [
  {
   "profileRef": "SMProfile-SegmentResponse",
   "dataItemMappings": [
    { "dataItemId": "cnc-01-parts-good", "category": "EVENT", "smAttribute": "qty_good", "dataType": "Int32" },
    { "dataItemId": "cnc-01-parts-scrap", "category": "EVENT", "smAttribute": "qty_scrap", "dataType": "Int32" },
    { "dataItemId": "cnc-01-program", "category": "EVENT", "smAttribute": "program_ref", "dataType": "String" },
    { "dataItemId": "cnc-01-tool", "category": "EVENT", "smAttribute": "tool_ref", "dataType": "String" },
    { "dataItemId": "cnc-01-exec", "category": "EVENT", "smAttribute": "program_status", "dataType": "String" }
   ]
  }
 ]
}
