{
  "sourceId": "erp-segment-responses",
  "version": "5.0.0",
  "sourceType": "rest",
  "functionalLevel": 4,
  "syncType": "polling",
  "profileRef": "SMProfile-SegmentResponse",
  "instanceRef": "werk1",
  "location": {
    "enterprise": "factory",
    "site": "werk1"
  },
  "transport": [
    "nats"
  ],
  "_comment": "Was keyed on `operation_id`, which /api/operations does NOT serve (16 fields, measured: order_id, production_order_no, operation_number, vorgangs_nr, work_center, machine_id, status, qty_planned, … Full text: docs/history/sites/werk1/sources/rest/erp-segment-responses.md, _comment.",
  "connection": {
    "baseUrl": "http://192.168.178.154:38260",
    "path": "/api/operations?since=P7D",
    "method": "GET",
    "auth": null,
    "timeoutMs": 10000
  },
  "response": {
    "format": "json",
    "rootPath": "$"
  },
  "polling": {
    "changeDetection": "full_refresh",
    "intervalMs": 900000,
    "batchSize": 5000,
    "paginate": true
  },
  "primaryKeyColumns": [
    "confirmation_no"
  ],
  "columnMappings": [
    {
      "column": "confirmation_no",
      "smAttribute": "segment_response_no",
      "isId": true
    },
    {
      "column": "production_order_no",
      "smAttribute": "production_order_ref"
    },
    {
      "column": "job_order_no",
      "smAttribute": "segment_requirement_ref"
    },
    {
      "column": "operation_number",
      "smAttribute": "sequence",
      "dataType": "Int32"
    },
    {
      "column": "qty_done",
      "smAttribute": "qty_actual",
      "dataType": "Double"
    },
    {
      "column": "machine_id",
      "smAttribute": "equipment_ref"
    },
    {
      "column": "started_at",
      "smAttribute": "actual_start_time"
    },
    {
      "column": "ended_at",
      "smAttribute": "actual_end_time"
    },
    {
      "column": "status",
      "smAttribute": "status",
      "valueMap": {
        "IN_PROCESS": "Running",
        "PARTIAL_CONFIRMED": "Running",
        "FINAL_CONFIRMED": "Completed"
      }
    },
    {
      "smAttribute": "operations_type",
      "const": "Production"
    }
  ],
  "filter": null,
  "edges": [
    {
      "type": "RESPONDS_TO",
      "fkColumn": "production_order_no",
      "targetIdProp": "production_order_no"
    },
    {
      "type": "RESPONDS_TO",
      "fkColumn": "job_order_no",
      "targetIdProp": "segment_requirement_no"
    },
    {
      "type": "ACTUAL_EQUIPMENT",
      "fkColumn": "machine_id",
      "targetIdProp": "element_id"
    }
  ],
  "$window": "0.6.6-g (owner 22.10.2026, the living window): the source reads the living part, not the whole history — every operation not final plus those started or ended in the last 7 days"
}
