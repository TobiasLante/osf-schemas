{
  "sourceId": "erp-customer-orders",
  "version": "1.3.0",
  "sourceType": "rest",
  "functionalLevel": 4,
  "syncType": "polling",
  "profileRef": "SMProfile-CustomerOrder",
  "instanceRef": "werk1",
  "location": {
    "enterprise": "factory",
    "site": "werk1"
  },
  "transport": [
    "nats"
  ],
  "connection": {
    "baseUrl": "http://192.168.178.154:38260",
    "path": "/api/customer-orders?since=P7D",
    "method": "GET",
    "auth": null,
    "timeoutMs": 10000
  },
  "response": {
    "format": "json",
    "rootPath": "$",
    "idProperty": "kundenauftrag_nr"
  },
  "polling": {
    "changeDetection": "full_refresh",
    "intervalMs": 300000,
    "batchSize": 5000,
    "paginate": true, "paginationMode": "keyset", "paginationOrderKey": "order_id", "keysetParam": "after_id" },
  "columnMappings": [
    {
      "column": "kundenauftrag_nr",
      "smAttribute": "order_no",
      "isId": true
    },
    {
      "column": "kunde_id",
      "smAttribute": "customer_ref"
    },
    {
      "column": "kunde_name",
      "smAttribute": "customer_name"
    },
    {
      "column": "geplante_stueckzahl",
      "smAttribute": "quantity"
    },
    {
      "column": "gesamtbetrag",
      "smAttribute": "total_amount"
    },
    {
      "column": "waehrung",
      "smAttribute": "currency"
    },
    {
      "column": "lieferdatum_soll",
      "smAttribute": "due_date"
    },
    {
      "column": "lieferdatum",
      "smAttribute": "customer_due_date"
    },
    {
      "column": "status",
      "smAttribute": "status",
      "valueMap": {
        "offen": "Waiting",
        "freigegeben": "Released",
        "in_arbeit": "Running",
        "fertig": "Completed",
        "abgeschlossen": "Closed",
        "storniert": "Cancelled"
      }
    },
    {
      "column": "prioritaet",
      "smAttribute": "priority"
    },
    {
      "column": "article_no",
      "smAttribute": "article_ref"
    },
    {
      "column": "article_name",
      "smAttribute": "article_name"
    },
    {
      "column": "production_order_no",
      "smAttribute": "production_order_ref"
    },
    {
      "column": "parent_order_no",
      "smAttribute": "parent_order_ref"
    },
    {
      "column": "status_raw",
      "smAttribute": "status_source"
    },
    {
      "column": "order_status",
      "smAttribute": "status_code"
    },
    {
      "column": "bestaetigt",
      "smAttribute": "confirmed"
    },
    {
      "column": "bestaetigt_lieferdatum",
      "smAttribute": "confirmed_delivery_date"
    },
    {
      "column": "lieferdatum_ist",
      "smAttribute": "actual_delivery_date"
    },
    {
      "column": "erstellt_am",
      "smAttribute": "created_at"
    },
    {
      "column": "aktualisiert_am",
      "smAttribute": "updated_at"
    },
    {
      "column": "abgeschlossen_am",
      "smAttribute": "closed_at"
    }
  ],
  "filter": null,
  "edges": [],
  "description": "ERP CustomerOrder (Level 4) from the sim-v5 ERP REST API, keyed by order_no; production orders reach it through sales_order_ref. Full text: docs/history/sites/werk1/sources/rest/erp-customer-orders.md, description."
}
