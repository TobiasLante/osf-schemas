{
  "syncId": "opcua-to-nats-cnc-mtc-01",
  "mappingId": "opcua-to-nats-cnc-mtc-01",
  "version": "2.0.0",
  "syncType": "polling",
  "description": "Standard OSF OT edge — subscribes the Sonder-Edge OPC-UA server and publishes promoted signals to the suite NATS hub (FACTORY stream), one subject tree per delivery class (sink.subjectPatterns). Full text: docs/history/sites/werk1/sync/nats/opcua-to-nats-cnc-mtc-01.md, description.",
  "profileRef": "SMProfile-CNC-Machine",
  "machineId": "cnc-mtc-01",
  "source": {
    "type": "opcua",
    "sourceRef": "opcua-mtbridge-cnc-01",
    "endpoint": "opc.tcp://sonderedge:4840/osf/mtbridge"
  },
  "sink": {
    "type": "nats",
    "server": "nats://osf-nats-hub:4222",
    "streams": {
      "telemetry": "FACTORY_TELEMETRY",
      "transactional": "FACTORY_TRANSACTIONAL"
    },
    "subjectPatterns": {
      "telemetry": "factory.{site}.{machine}.telemetry.{attr}",
      "transactional": "factory.{site}.{machine}.event.{attr}"
    }
  }
}
