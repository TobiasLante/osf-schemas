{
  "elementId": "SMProfile-SegmentResponse",
  "displayName": "Segment Response (segment actuals per order)",
  "namespaceUri": "urn:osf:schemas:operations",
  "version": "2.0.0",
  "schema": {
    "description": "Level-3 MOM SegmentResponse (ISA-95 Part 4 / B2MML OperationsResponse.SegmentResponse) = the actuals per manufacturing stage. Full text: docs/history/profiles/operations/segment-response.md, description.",
    "type": "object",
    "properties": {
      "segment_response_no": {
        "type": "string",
        "description": "Identity of the SegmentResponse (join key). Recommendation: <production_order_no>.<sequence>.",
        "x-category": "Core",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change",
        "x-valueType": "ID"
      },
      "operations_response_ref": {
        "type": "string",
        "description": "FK to OperationsResponse.production_order_no (PART_OF). The order actuals to which these segment actuals belong.",
        "x-category": "Link",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change",
        "x-valueType": "ID"
      },
      "segment_requirement_ref": {
        "type": "string",
        "description": "FK to SegmentRequirement.segment_requirement_no (CORRESPONDS_TO). The target segment whose actuals are reported here.",
        "x-category": "Link",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change",
        "x-valueType": "ID"
      },
      "process_segment_ref": {
        "type": "string",
        "description": "FK to ProcessSegment.process_segment_no (FOR_SEGMENT). Which manufacturing stage was executed.",
        "x-category": "Link",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change",
        "x-valueType": "ID"
      },
      "sequence": {
        "type": "integer",
        "description": "Sequence of this segment within the order.",
        "x-dataType": "Int32",
        "x-category": "Execution",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "material_lot_ref": {
        "type": "string",
        "description": "FK to MaterialLot.material_lot_no (PROCESSED_MATERIAL) = MaterialActual.MaterialLotID. The material lot actually consumed/produced; role via material_use.",
        "x-category": "Link",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change",
        "x-valueType": "ID"
      },
      "material_use": {
        "type": "string",
        "description": "ISA-95 MaterialActual.MaterialUse — the ROLE of the material (actual). Mirrors the SegmentRequirement role.",
        "enum": [
          "Consumed",
          "Produced",
          "Consumable",
          "ByProduct",
          "Sample",
          "MovedFrom",
          "MovedTo"
        ],
        "x-category": "Execution",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "qty_actual": {
        "type": "number",
        "description": "Actual quantity of this material role (actual). Counterpart to SegmentRequirement.qty_planned.",
        "x-dataType": "Double",
        "x-category": "Execution",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change",
        "x-quality": {
          "onBad": "flag"
        }
      },
      "unit_of_measure": {
        "type": "string",
        "description": "Unit of measure of qty_actual.",
        "x-category": "Execution",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "equipment_ref": {
        "type": "string",
        "description": "FK to Machine.machine_id (USED_EQUIPMENT; Machine ≡ EquipmentUnit level) = EquipmentActual.EquipmentID. The equipment actually used.",
        "x-category": "Link",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change",
        "x-valueType": "ID"
      },
      "actual_start_time": {
        "type": "string",
        "format": "date-time",
        "description": "Actual stage start (actual).",
        "x-dataType": "DateTime",
        "x-category": "Timing",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change",
        "x-quality": {
          "onBad": "flag"
        }
      },
      "actual_end_time": {
        "type": "string",
        "format": "date-time",
        "description": "Actual stage end (actual).",
        "x-dataType": "DateTime",
        "x-category": "Timing",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change",
        "x-quality": {
          "onBad": "flag"
        }
      },
      "status": {
        "type": "string",
        "description": "Actual status of the stage (e.g. running, complete, aborted). Derived from the MES OrderState.",
        "x-category": "Core",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change",
        "x-quality": {
          "onBad": "flag"
        }
      }
    },
    "required": [
      "segment_response_no",
      "operations_response_ref"
    ]
  },
  "x-osf": {
    "source": "profiles/operations/segment-response.json",
    "standard": "ISA-95",
    "category": "business",
    "abstract": false,
    "relationships": [
      {
        "type": "PART_OF",
        "target": "OperationsResponse",
        "targetIdProp": "production_order_no",
        "description": "The order actuals that contain these segment actuals."
      },
      {
        "type": "CORRESPONDS_TO",
        "target": "SegmentRequirement",
        "targetIdProp": "segment_requirement_no",
        "description": "ISA-95 'corresponds to' — the target segment."
      },
      {
        "type": "FOR_SEGMENT",
        "target": "ProcessSegment",
        "targetIdProp": "process_segment_no",
        "description": "The executed manufacturing stage (= plant = Function)."
      },
      {
        "type": "PROCESSED_MATERIAL",
        "target": "MaterialLot",
        "targetIdProp": "material_lot_no",
        "description": "The material lot consumed/produced; role via material_use."
      },
      {
        "type": "USED_EQUIPMENT",
        "target": "Machine",
        "targetIdProp": "machine_id",
        "description": "The equipment actually used (Machine ≡ EquipmentUnit level, consolidation 2026-07-15 — the source fkColumn carries machine ids)."
      }
    ],
    "constraints": [],
    "semantics": [
      "iso:62264-SegmentResponse"
    ],
    "kpiRefs": [],
    "isa95": {
      "objectModel": "SegmentResponse",
      "momDomain": "production",
      "level": 3,
      "note": "ISA-95 Part 4 OperationsResponse.SegmentResponse = actuals per ProcessSegment, with MaterialActual (MaterialUse=role, MaterialLot) + EquipmentActual. Full text: docs/history/profiles/operations/segment-response.md, isa95 › note.",
      "propertyMap": {
        "segment_response_no": "OperationsResponse.SegmentResponse.ID",
        "operations_response_ref": "OperationsResponse.ID",
        "segment_requirement_ref": "OperationsResponse.SegmentResponse.SegmentRequirementID",
        "process_segment_ref": "OperationsResponse.SegmentResponse.ProcessSegmentID",
        "material_lot_ref": "OperationsResponse.SegmentResponse.MaterialActual.MaterialLotID",
        "material_use": "OperationsResponse.SegmentResponse.MaterialActual.MaterialUse",
        "qty_actual": "OperationsResponse.SegmentResponse.MaterialActual.Quantity",
        "equipment_ref": "OperationsResponse.SegmentResponse.EquipmentActual.EquipmentID",
        "actual_start_time": "OperationsResponse.SegmentResponse.ActualStartTime",
        "actual_end_time": "OperationsResponse.SegmentResponse.ActualEndTime",
        "status": "OperationsResponse.SegmentResponse.SegmentState"
      }
    },
    "kgNodeLabel": "SegmentResponse",
    "kgIdProperty": "segment_response_no",
    "parentType": null,
    "requiredDeclaredOn": [
      "segment_response_no",
      "operations_response_ref",
      "segment_requirement_ref",
      "process_segment_ref",
      "sequence",
      "material_lot_ref",
      "material_use",
      "qty_actual",
      "unit_of_measure",
      "equipment_ref",
      "actual_start_time",
      "actual_end_time",
      "status"
    ]
  }
}
