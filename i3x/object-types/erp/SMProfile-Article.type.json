{
  "elementId": "SMProfile-Article",
  "displayName": "Article (article / part)",
  "namespaceUri": "urn:osf:schemas:erp",
  "version": "2.1.0",
  "schema": {
    "description": "Product/material master. Full text: docs/history/profiles/erp/article.md, description.",
    "type": "object",
    "properties": {
      "article_no": {
        "type": "string",
        "x-category": "Core",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change",
        "x-valueType": "ID"
      },
      "name": {
        "type": "string",
        "x-category": "Core",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "type": {
        "type": "string",
        "x-category": "Core",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "unit": {
        "type": "string",
        "x-category": "Core",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "lead_time_days": {
        "type": "integer",
        "x-dataType": "Int32",
        "x-category": "Planning",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "abc_class": {
        "type": "string",
        "x-category": "Commercial",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "cost_hk": {
        "type": "number",
        "description": "Standard manufacturing/purchase cost (HK = Herstellkosten), from ERP std_kosten. The €-basis for scrap / quality impact.",
        "x-dataType": "Double",
        "x-category": "Valuation",
        "x-currency": "EUR",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "price_vk": {
        "type": "number",
        "description": "Standard sales price (VK = Verkaufspreis), from ERP std_verkaufspreis. The basis for margin / lost-sales impact. Null for non-sellable articles (RAW/CONSUMABLE/WIP).",
        "x-dataType": "Double",
        "x-category": "Valuation",
        "x-currency": "EUR",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "currency": {
        "type": "string",
        "description": "ISO-4217 currency code for cost_hk / price_vk, from ERP waehrung (e.g. EUR).",
        "x-category": "Valuation",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "stock_free": {
        "type": "number",
        "description": "Free (unblocked) stock of this article across all warehouses (menge_frei). Served by GET /api/articles, which is ARTICLE_WITH_STOCK_AND_PRICE_SQL. This is the article-level figure the WMS Quant rows sum to; a single Quant is one pallet/lot in one bin and is NOT a stock position.",
        "x-category": "Stock",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "stock_reserved": {
        "type": "number",
        "description": "Quantity already committed to orders (menge_reserviert) — free stock that is spoken for.",
        "x-category": "Stock",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "stock_blocked": {
        "type": "number",
        "description": "Quantity blocked / on hold (menge_blockiert).",
        "x-category": "Stock",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "stock_available": {
        "type": "number",
        "description": "AVAILABLE-TO-PROMISE: free minus reserved (verfuegbar). Full text: docs/history/profiles/erp/article.md, attributes › stock_available › description.",
        "x-category": "Stock",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "reorder_level": {
        "type": "number",
        "description": "Reorder level / Meldebestand from the ERP article master (mindestbestand). Full text: docs/history/profiles/erp/article.md, attributes › reorder_level › description.",
        "x-category": "Planning",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      },
      "safety_stock": {
        "type": "number",
        "description": "Safety stock (safety_stock). Full text: docs/history/profiles/erp/article.md, attributes › safety_stock › description.",
        "x-category": "Planning",
        "x-delivery": "transactional",
        "x-scope": "hub",
        "x-promotion": "on_change"
      }
    },
    "required": [
      "article_no"
    ]
  },
  "x-osf": {
    "source": "profiles/erp/article.json",
    "standard": "CESMII",
    "category": "business",
    "abstract": false,
    "relationships": [],
    "constraints": [
      {
        "name": "stock_below_reorder_level",
        "description": "Stock below the reorder level: the article's available-to-promise stock (free minus reserved) has fallen under the reorder level the ERP article master declares FOR THIS ARTICLE. The IT/planning counterpart to the OT machine bands - a materials-planning finding about an article, not about a machine.",
        "require": {
          "attr": "stock_available",
          "op": "gte",
          "valueAttr": "reorder_level"
        },
        "severity": "warning",
        "discrepancyClass": "constraint",
        "concern": "operations",
        "mom_category": "inventory",
        "accountable_role": "Materials Planning",
        "since": "2026-08-30"
      }
    ],
    "semantics": [],
    "kpiRefs": [],
    "isa95": {
      "objectModel": "MaterialDefinition",
      "momDomain": "inventory",
      "level": 3,
      "note": "Article / part = ISA-95 MaterialDefinition (Part 2). Physical stock is MaterialLot.",
      "propertyMap": {
        "article_no": "MaterialDefinition.ID",
        "name": "MaterialDefinition.Description",
        "unit": "MaterialDefinition.UnitOfMeasure"
      }
    },
    "kgNodeLabel": "Article",
    "kgIdProperty": "article_no",
    "parentType": null,
    "requiredDeclaredOn": [
      "article_no",
      "name",
      "type",
      "unit",
      "lead_time_days",
      "abc_class",
      "cost_hk",
      "price_vk",
      "currency",
      "stock_free",
      "stock_reserved",
      "stock_blocked",
      "stock_available",
      "reorder_level",
      "safety_stock"
    ]
  }
}
