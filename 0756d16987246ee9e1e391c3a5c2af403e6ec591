a/opcua-rockwell-01-event.json","sourceId":"opcua-rockwell-01-event","profile":"SMProfile-SegmentResponse","property":"qty_good","as":"Act_Amount_LifeTimeGood"},{"file":"sites/werk1/sources/opcua/opcua-rockwell-01-event.json","sourceId":"opcua-rockwell-01-event","profile":"SMProfile-SegmentResponse","property":"qty_scrap","as":"Act_Amount_LifeTimeScrap"},{"file":"sites/werk1/sources/opcua/opcua-sgm-001-event.json","sourceId":"opcua-sgm-001-event","profile":"SMProfile-SegmentResponse","property":"qty_good","as":"Act_Amount_LifeTimeGood"},{"file":"sites/werk1/sources/opcua/opcua-sgm-001-event.json","sourceId":"opcua-sgm-001-event","profile":"SMProfile-SegmentResponse","property":"qty_scrap","as":"Act_Amount_LifeTimeScrap"},{"file":"sites/werk1/sources/opcua/opcua-sgm-001-event.json","sourceId":"opcua-sgm-001-event","profile":"SMProfile-SegmentResponse","property":"qty_total","as":"Act_Amount_LifeTime"},{"file":"sites/werk1/sources/opcua/opcua-sgm-004-processdata.json","sourceId":"opcua-sgm-004-processdata","profile":"SMProfile-SegmentResponse","property":"qty_good","as":"Act_Amount_LifeTimeGood"},{"file":"sites/werk1/sources/opcua/opcua-sgm-004-processdata.json","sourceId":"opcua-sgm-004-processdata","profile":"SMProfile-SegmentResponse","property":"qty_scrap","as":"Act_Amount_LifeTimeScrap"},{"file":"sites/werk1/sources/opcua/opcua-sgm-004-processdata.json","sourceId":"opcua-sgm-004-processdata","profile":"SMProfile-SegmentResponse","property":"qty_total","as":"Act_Amount_LifeTime"},{"file":"sites/werk1/sources/opcua/opcua-sgm-005-processdata.json","sourceId":"opcua-sgm-005-processdata","profile":"SMProfile-SegmentResponse","property":"qty_good","as":"Act_Amount_LifeTimeGood"},{"file":"sites/werk1/sources/opcua/opcua-sgm-005-processdata.json","sourceId":"opcua-sgm-005-processdata","profile":"SMProfile-SegmentResponse","property":"qty_scrap","as":"Act_Amount_LifeTimeScrap"},{"file":"sites/werk1/sources/opcua/opcua-sgm-005-processdata.json","sourceId":"opcua-sgm-005-processdata","profile":"SMProfile-SegmentResponse","property":"qty_total","as":"Act_Amount_LifeTime"},{"file":"sites/werk1/sources/opcua/opcua-sgm-006-bde.json","sourceId":"opcua-sgm-006-bde","profile":"SMProfile-SegmentResponse","property":"qty_good","as":"Act_Amount_LifeTimeGood"},{"file":"sites/werk1/sources/opcua/opcua-sgm-006-bde.json","sourceId":"opcua-sgm-006-bde","profile":"SMProfile-SegmentResponse","property":"qty_scrap","as":"Act_Amount_LifeTimeScrap"},{"file":"sites/werk1/sources/opcua/opcua-sgm-006-bde.json","sourceId":"opcua-sgm-006-bde","profile":"SMProfile-SegmentResponse","property":"qty_total","as":"Act_Amount_LifeTime"}],"deprecated":[],"needsKey":[],"openFields":[],"streams":{"plants":[]},"breaking":[{"core":"6.0.0","id":"machines-work-cell","text":"Machines: a discrete machine (CNC, injection moulding) is a WorkCell of a ProductionLine — ISA-95 Part 1 role-based hierarchy, discrete production (audit H1) — no longer a Unit of a ProcessCell (the batch branch). SMProfile-Machine, -CNC-Machine, -InjectionMoldingMachine fix no place (owner 29.10.2026: the level is where the instance stands; the class keeps only the generic WorkUnit the level lint needs, audit M-03) — in a ProductionLine a machine is a WorkCell, free-standing a WorkUnit of a WorkCenter; Machine PART_OF WorkCenter (see machine-part-of-work-center); a plant's lines become ProductionLine, their machines WorkCell. The codes stay, so the UNS addresses of the line machines stay (the free-standing ones move once, see pool-is-equipment-class); every reader of a level (rules, screens) takes a work unit as a machine.","profiles":["SMProfile-Machine","SMProfile-CNC-Machine","SMProfile-InjectionMoldingMachine"]},{"core":"6.0.0","id":"machine-part-of-work-center","text":"Work centers: every work center of the plant tree (ProductionLine, WorkCenter, ProcessCell …) is an instance of SMProfile-WorkCenter — the generic work center of ISA-95 Part 1/2, one KG label WorkCenter keyed by element_id; its role is the instance's equipmentLevel (B2MML Equipment.EquipmentLevel). Machine PART_OF ProductionLine, a tree target without a node label in the contract (audit M-04), is gone: a machine is PART_OF its WorkCenter, whatever role the work center plays. The ids and codes stay, so the UNS addresses stay; a reader that matched (:ProductionLine) matches (:WorkCenter) and reads the level from the instance.","profiles":["SMProfile-Machine","SMProfile-WorkCenter"]},{"core":"6.0.0","id":"pool-is-equipment-class","text":"ERP pools leave the equipment tree (owner 29.10.2026 ~22:45, supersedes X2 of the same day): an ERP pool (POOL-SGM, POOL-CNC) is an EquipmentClass — a capability / planning group, source erp-machine-pools — and no work center. The 35 free-standing machines of werk1 (18 injection moulding, 17 CNC) are WorkUnits of one workshop WorkCenter per area: sgm-workshop \"Spritzguss-Werkstatt\" and cnc-workshop \"CNC-Werkstatt\" replace the work centers sgm-pool (code pool-sgm) and cnc-pool (code pool-cnc). Machine ids and codes stay; their UNS address moves once, in this core: factory/werk1/sgm/pool-sgm/<machine> → factory/werk1/sgm/sgm-workshop/<machine>, factory/werk1/cnc/pool-cnc/<machine> → factory/werk1/cnc/cnc-workshop/<machine>. Machines in real lines keep their place and address.","profiles":["SMProfile-WorkCenter","SMProfile-Machine","SMProfile-EquipmentClass"]},{"core":"6.0.0","id":"production-order-status","text":"Production order: status speaks the B2MML RequestState vocabulary (B2MML-Common.xsd RequestState1Type) instead of our own list — offen → Waiting, freigegeben → Released, in_arbeit → Running, fertig → Completed, abgeschlossen → Closed, storniert → Cancelled (the way the customer order moved in core 5.0.0); the rule material_ready_after_planned_end guards Released and Running; a source maps its words with valueMap.","profiles":["SMProfile-ProductionOrder"]},{"core":"6.0.0","id":"response-states","text":"Operations response, segment response, job response, job order, work response, work order: status speaks the B2MML state lists (ResponseState1Type, JobOrderDispatchStatus1Type, RequestState1Type) — the operations response's in_arbeit / fertig become Running / Completed; a source maps its words with valueMap (ERP: IN_PROCESS and PARTIAL_CONFIRMED → Running, FINAL_CONFIRMED → Completed; PLANNED → Waiting, RELEASED → Released, IN_PROGRESS → Running, COMPLETED → Completed, CANCELLED → Cancelled, ON_HOLD → Held).","profiles":["SMProfile-OperationsResponse","SMProfile-SegmentResponse","SMProfile-JobResponse","SMProfile-JobOrder","SMProfile-WorkResponse","SMProfile-Workorder"]},{"core":"6.0.0","id":"operations-type","text":"Process segment and operations segment: operations_type speaks B2MML OperationsType (Production, Maintenance, Quality, Inventory, Mixed, Other) instead of lower-case words; a source maps production → Production, quality → Quality, inventory → Inventory, maintenance → Maintenance.","profiles":["SMProfile-ProcessSegment","SMProfile-OperationsSegment"]},{"core":"6.0.0","id":"material-use","text":"Segment requirement and segment response: material_use speaks B2MML MaterialUse (Consumable, Consumed, Produced, By-product Produced, Co-product Produced, Yield Produced, Material Consumed, Material Produced, Destructive Sample, Returned Sample, Retained Sample, Inventoried, Other) instead of our own list (ByProduct, Sample, MovedFrom, MovedTo); no source of the demo plant fills it today.","profiles":["SMProfile-SegmentRequirement","SMProfile-SegmentResponse"]},{"core":"6.0.0","id":"code-list-enums","text":"Every attribute mapped onto a B2MML field with a code list carries that list as its enum (lint-isa95 I19): work_type / operations_type, the schedule, performance and directive states, capability_type, the operations event type, level, MOM and enterprise function, assembly type and relationship, relationship type and form, dependency, definition type, spatial format. A source that sends another word maps it with valueMap.","profiles":["SMProfile-JobList","SMProfile-JobResponseList","SMProfile-OperationsEventDefinition","SMProfile-OperationsEvent","SMProfile-OperationsMaterialBillItem","SMProfile-OperationsPerformance","SMProfile-OperationsSchedule","SMProfile-ResourceRelationshipNetwork","SMProfile-WorkCapability","SMProfile-WorkDirective","SMProfile-WorkMasterCapability","SMProfile-WorkMaster","SMProfile-WorkPerformance","SMProfile-WorkSchedule","SMProfile-WorkflowSpecificationConnectionType","SMProfile-WorkflowSpecificationConnection","SMProfile-WorkflowSpecification","SMProfile-OperationsCapability","SMProfile-Machine","SMProfile-Tooling","SMProfile-StorageLocation","SMProfile-Person"]},{"core":"6.0.0","id":"tooling","text":"Tool becomes Tooling (owner D3 13.10.2026, audit H2): an abstract physical asset with the kinds Mould, Die, CuttingTool and Fixture; parts_per_shot (the cavity count) lives on the Mould, tool_type is the profile itself, unit_ref and the edges Tool IMPLEMENTATION_OF Machine / InjectionMoldingMachine IMPLEMENTED_BY Tool are gone — the tool a machine runs with is the segment's PhysicalAssetRequirement / PhysicalAssetActual (REQUIRES_PHYSICAL_ASSET / ACTUAL_PHYSICAL_ASSET → Tooling). Every edge to Tool now targets Tooling; the key stays tool_id.","profiles":["SMProfile-Tooling","SMProfile-Mould","SMProfile-Die","SMProfile-CuttingTool","SMProfile-Fixture","SMProfile-InjectionMoldingMachine"]},{"core":"6.0.0","id":"segment-work-center","text":"Segment requirement and segment response: process_segment_ref is no longer filled with the ERP work center of the operation (POOL-SGM, POOL-CNC — equipment, not a process segment; audit M-11), and the FOR_PROCESS_SEGMENT edge on it is gone from erp-segment-requirements (it never resolved: the process segments are VORMONTAGE, MONTAGE, PRUEFFELD, VERSAND). process_segment_ref stays declared and is unbound until the ERP serves the routing operation's process segment. The work center is the operation's equipment requirement by class instead (owner 29.10.2026: the pool is an EquipmentClass): erp-segment-requirements maps work_center onto equipment_class_ref (B2MML SegmentRequirement.EquipmentRequirement.EquipmentClassID) and draws REQUIRES_EQUIPMENT → EquipmentClass.","profiles":["SMProfile-SegmentRequirement","SMProfile-SegmentResponse"]},{"core":"6.0.0","id":"machine-signals-act-style","text":"Machine signals (owner 29.10.2026, step 2): every machine signal is named <Act|Set|Plan>_<Kind>_<Name>. The signals every machine shares go up into SMProfile-Machine 5.0.0, one name for every machine — Act_Status_Machine, Act_Mode_Machine, Act_Amount_Alarm, Act_Time_Uptime, Act_State_ShiftActive, Act_Power_Machine, Act_Time_Cycle, Act_State_InCycle (owner 30.10.2026: CNC Act_Time_Cycle / Act_State_InCycle, IMM cycleTimeSec / inCycle) and the lifetime counters Act_Amount_LifeTime / LifeTimeGood / LifeTimeScrap; CNC-Machine 5.0.0 and InjectionMoldingMachine 5.0.0 lose their own copy. The IMM signals take the Act_ names (hotrunnerTempC → Act_Temp_Hotrunner, inCycle → Act_State_InCycle …), the CNC renames Act_Text_MachineMode → Act_Mode_Machine, Act_Energy_Power → Act_Power_Machine, Act_Energy_PowerSpindle → Act_Power_Spindle. Each old name is a movedAttributes entry of its profile (a lift: to SMProfile-Machine), so the move renames the mappings, recipe parameters, KPI mappings and own rules that name it. Set_Pct_HopperRefill (was hopperRefillThresholdPct, a limit: a setting) is a setpoint and travels transactional on_change like every setpoint. The IMM class settings (recipe:*) keep their names.","profiles":["SMProfile-Machine","SMProfile-CNC-Machine","SMProfile-InjectionMoldingMachine"]},{"core":"6.0.0","id":"parts-count-lifetime","text":"The machine's parts counters (owner 30.10.2026): an OPC UA partsCount node (good, scrap, total) is the machine's lifetime counter, Act_Amount_LifeTimeGood / Act_Amount_LifeTimeScrap / Act_Amount_LifeTime of SMProfile-Machine (cumulative, resettable) — no longer the order quantities qty_good / qty_scrap / qty_total of the SegmentResponse the source reports on (those come from the ERP). The move re-points every such mapping (owner 31.10.2026); the KPIs oee, quality-rate, scrap-rate and energy-per-part read the lifetime counters.","profiles":["SMProfile-Machine","SMProfile-SegmentResponse"]}]},"objects":[{"path":"sites/werk1/consumers/edge-cnc-001.json","class":"consumers","blobSha":"fa56dff95914fe71e846f6439e363f3c7f6baa5e","signatures":[]},{"path":"sites/werk1/consumers/edge-cnc-002.json","class":"consumers","blobSha":"c7948266a3a653f3e04bb1aa19671422eef2f593","signatures":[]},{"path":"sites/werk1/consumers/edge-cnc-mtc-02.json","class":"consumers","blobSha":"990ab124caaa07715dd22d063f7afabd2244f157","signatures":[]},{"path":"sites/werk1/consumers/edge-mtc-sonder.json","class":"consumers","blobSha":"709af97f59b5f3db2cbb14369f08df1bf69e75fd","signatures":[]},{"path":"sites/werk1/consumers/edge-mtc-standard.json","class":"consumers","blobSha":"75328a8c0b6d9de800970aa304a9a9b83ab75de0","signatures":[]},{"path":"sites/werk1/consumers/edge-sgm-004.json","class":"consumers","blobSha":"8fa38b01028d30cae32b88dbd867a4622f8195ab","signatures":[]},{"path":"sites/werk1/consumers/edge-sgm-005.json","class":"consumers","blobSha":"3122278f8041dfbc9eab07bfc3cb7473a007614f","signatures":[]},{"path":"sites/werk1/consumers/edge-sgm-006.json","class":"consumers","blobSha":"8c1808171946e54a22d162518c26efac15e6774d","signatures":[]},{"path":"sites/werk1/consumers/ext-highbyte-111.json","class":"consumers","blobSha":"a13737ac3c014525be59efef459610c24851971c","signatures":[]},{"path":"sites/werk1/consumers/ext-iflow-111.json","class":"consumers","blobSha":"d8cd3029391019a1f22706edfc0154a84f05a345","signatures":[]},{"path":"sites/werk1/consumers/ext-node-red-111.json","class":"consumers","blobSha":"dd5dfc09d616e505be9732a54832b611cb66b3e7","signatures":[]},{"path":"sites/werk1/consumers/it-erp-sap.json","class":"consumers","blobSha":"8275ee348f