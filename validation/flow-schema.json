{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://osf-schemas/validation/flow-schema.json",
  "title": "Flow",
  "description": "Meta-schema for flows/*.json. Defines the shape of a Node-RED flow template (processors + wiring) used by the discovery / gen-flows pipeline.",
  "type": "object",
  "required": ["flowSchemaId", "version", "name", "processors", "wiring"],
  "properties": {
    "flowSchemaId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "sourceRefs": { "type": "array", "items": { "type": "string" } },
    "syncRef": { "type": "string" },
    "profileRef": { "type": "string" },
    "processors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "wiring": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" }
        }
      }
    },
    "schedule": { "type": "object" }
  },
  "patternProperties": {
    "^\\$": { "type": "string" }
  },
  "additionalProperties": false
}
